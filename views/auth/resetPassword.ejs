<%- include('../partials/header', { title: 'Reset Password', messages: typeof messages !== 'undefined' ? messages : {}, user: null }) %>

<div class="auth-split-container">

    <!-- LEFT SIDEBAR -->
    <div class="auth-sidebar-panel d-none d-lg-flex">
        <div class="mb-5">
            <i class="bi bi-mortarboard-fill text-white" style="font-size:3.25rem;"></i>
            <h2 class="text-white mt-3 fw-bold display-6">ExamSystem</h2>
            <p class="lead opacity-75">Secure, robust, and intuitive examination environment for global educators and students.</p>
        </div>
        <div class="mt-4">
            <div class="d-flex align-items-start gap-3 mb-4">
                <i class="bi bi-shield-lock fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">Enter Your OTP</h5>
                    <p class="mb-0 small text-white-50">The 6-digit code was sent to your registered email.</p>
                </div>
            </div>
            <div class="d-flex align-items-start gap-3 mb-4">
                <i class="bi bi-lock fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">Set New Password</h5>
                    <p class="mb-0 small text-white-50">Choose a strong password with letters, numbers and symbols.</p>
                </div>
            </div>
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-clock fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">10-Minute Window</h5>
                    <p class="mb-0 small text-white-50">OTP expires in 10 minutes. Request a new one if needed.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT FORM PANEL -->
    <div class="auth-form-panel mx-auto">
        <div class="auth-form-wrapper pb-4">

            <!-- Icon -->
            <div class="text-center mb-4">
                <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width:64px;height:64px;background:linear-gradient(135deg,#1E3A8A,#10B981);">
                    <i class="bi bi-shield-lock-fill text-white fs-3"></i>
                </div>
                <h3 class="fw-bold mb-1">Reset Your Password</h3>
                <p class="text-muted small">
                    Enter the OTP sent to
                    <strong class="text-primary"><%= email %></strong>
                    and choose a new password.
                </p>
            </div>

            <!-- OTP Countdown -->
            <div id="otpTimerBox" style="background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 14px;margin-bottom:1.25rem;display:flex;align-items:center;gap:8px;font-size:0.85rem;">
                <i class="bi bi-clock" id="otpTimerIcon" style="color:#d97706;"></i>
                <span style="color:#92400e;">OTP expires in <strong id="otpCountdown">10:00</strong></span>
            </div>

            <form action="/reset-password" method="POST" id="resetForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="email" value="<%= email %>">

                <!-- OTP input (6 separate boxes) -->
                <div class="mb-4">
                    <label class="form-label fw-semibold small">6-Digit OTP</label>
                    <div class="d-flex gap-2 justify-content-between" id="otpBoxes">
                        <% for(let i = 0; i < 6; i++) { %>
                        <input type="text" maxlength="1" inputmode="numeric"
                               class="form-control text-center fw-bold otp-box"
                               style="width:48px;height:52px;font-size:1.4rem;border-radius:10px;"
                               data-index="<%= i %>" autocomplete="off">
                        <% } %>
                    </div>
                    <!-- Hidden combined OTP value submitted with form -->
                    <input type="hidden" name="otp" id="otpCombined">
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold small">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" id="newPassword" name="newPassword"
                               class="form-control border-start-0 border-end-0"
                               placeholder="Min. 6 characters" required minlength="6"
                               autocomplete="new-password">
                        <button class="btn btn-light border border-start-0" type="button"
                                onclick="togglePwd('newPassword', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <!-- Strength bar -->
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="progress flex-grow-1" style="height:4px;">
                            <div class="progress-bar" id="strengthBar" style="width:0%;transition:all 0.3s;"></div>
                        </div>
                        <small id="strengthText" class="text-muted" style="min-width:70px;font-size:0.7rem;"></small>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key text-muted"></i></span>
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               class="form-control border-start-0 border-end-0"
                               placeholder="Re-enter password" required minlength="6"
                               autocomplete="new-password">
                        <button class="btn btn-light border border-start-0" type="button"
                                onclick="togglePwd('confirmPassword', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3" id="resetBtn">
                    <i class="bi bi-check-circle me-2"></i>Reset Password
                </button>
            </form>

            <div class="text-center" id="bottomLinks">
                <button type="button" id="resendOtpBtn"
                        class="btn btn-link text-decoration-none text-muted small p-0"
                        style="font-size:0.85rem;" disabled>
                    <i class="bi bi-arrow-clockwise me-1"></i><span id="resendBtnText">Resend OTP</span>
                </button>
                <span class="text-muted mx-2">·</span>
                <a href="/login" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>

        </div>
    </div>
</div>

<script>
// ── OTP boxes: auto-advance, backspace, paste ────────────────────────
const boxes = Array.from(document.querySelectorAll('.otp-box'));
const otpCombined = document.getElementById('otpCombined');

boxes.forEach((box, i) => {
    box.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '').slice(-1);
        this.classList.remove('is-invalid'); // clear red border on typing
        if (this.value && i < boxes.length - 1) boxes[i + 1].focus();
        syncOtp();
    });
    box.addEventListener('keydown', function (e) {
        if (e.key === 'Backspace' && !this.value && i > 0) boxes[i - 1].focus();
    });
    box.addEventListener('paste', function (e) {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
        text.split('').forEach((ch, idx) => {
            if (boxes[idx]) {
                boxes[idx].value = ch;
                boxes[idx].classList.remove('is-invalid');
            }
        });
        const last = Math.min(text.length, boxes.length) - 1;
        if (boxes[last]) boxes[last].focus();
        syncOtp();
    });
});

function syncOtp() {
    otpCombined.value = boxes.map(b => b.value).join('');
}

// ── Form submit: validate OTP filled ────────────────────────────────
document.getElementById('resetForm').addEventListener('submit', function (e) {
    syncOtp();
    if (otpCombined.value.length < 6) {
        e.preventDefault();
        boxes.forEach(b => {
            if (!b.value) b.classList.add('is-invalid');
        });
        showModal(
            'bi-shield-exclamation',
            'warning',
            'Incomplete OTP',
            'Please enter all 6 digits of the OTP sent to your email before proceeding.'
        );
        return;
    }
    boxes.forEach(b => b.classList.remove('is-invalid'));
    const np = document.getElementById('newPassword').value;
    const cp = document.getElementById('confirmPassword').value;
    if (np !== cp) {
        e.preventDefault();
        document.getElementById('confirmPassword').classList.add('is-invalid');
        showModal(
            'bi-key-fill',
            'danger',
            'Passwords Do Not Match',
            'Your new password and confirmation password are different. Please re-enter them carefully.'
        );
        return;
    }
    const btn = document.getElementById('resetBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Resetting...';
});

// ── Password toggle ──────────────────────────────────────────────────
function togglePwd(id, btn) {
    const inp = document.getElementById(id);
    const ic = btn.querySelector('i');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    ic.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}

// ── Password strength ────────────────────────────────────────────────
document.getElementById('newPassword').addEventListener('input', function () {
    const v = this.value;
    let s = 0;
    if (v.length >= 6) s++;
    if (v.length >= 10) s++;
    if (/[A-Z]/.test(v)) s++;
    if (/[0-9]/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    const levels = [
        { pct:0,  cls:'',           lbl:'' },
        { pct:20, cls:'bg-danger',  lbl:'Very Weak' },
        { pct:40, cls:'bg-warning', lbl:'Weak' },
        { pct:60, cls:'bg-info',    lbl:'Fair' },
        { pct:80, cls:'bg-primary', lbl:'Strong' },
        { pct:100,cls:'bg-success', lbl:'Very Strong' },
    ];
    const lv = levels[s] || levels[0];
    const bar = document.getElementById('strengthBar');
    bar.style.width = lv.pct + '%';
    bar.className = 'progress-bar ' + lv.cls;
    document.getElementById('strengthText').textContent = lv.lbl;
});

// ── Confirm password live mismatch indicator ─────────────────────────
document.getElementById('confirmPassword').addEventListener('input', function () {
    const match = this.value === document.getElementById('newPassword').value;
    this.classList.toggle('is-invalid', !match && this.value.length > 0);
    this.classList.toggle('is-valid', match && this.value.length > 0);
});

// ── Resend OTP button ────────────────────────────────────────────────
document.getElementById('resendOtpBtn').addEventListener('click', function () {
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Sending...';

    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrf = csrfMeta ? csrfMeta.getAttribute('content') : '';

    fetch('/resend-otp', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrf
        },
        body: JSON.stringify({ email: '<%= email %>' })
    })
    .then(r => r.json())
    .then(data => {
        if (data.ok) {
            // Update expiry and restart timer
            expiryMs = data.expiryTs;
            sessionStorage.setItem(STORAGE_KEY, expiryMs);

            // Reset timer box back to yellow style
            const timerBox  = document.getElementById('otpTimerBox');
            const timerIcon = document.getElementById('otpTimerIcon');
            if (timerBox) {
                timerBox.style.background = '#fffbeb';
                timerBox.style.borderColor = '#fde68a';
                const span = timerBox.querySelector('span');
                if (span) span.style.color = '#92400e';
            }
            if (timerIcon) { timerIcon.className = 'bi bi-clock'; timerIcon.style.color = '#d97706'; }

            // Clear OTP boxes
            boxes.forEach(b => { b.value = ''; b.classList.remove('is-invalid'); });
            syncOtp();
            if (boxes[0]) boxes[0].focus();

            // Restore resend button to disabled/muted state
            btn.disabled = true;
            btn.className = 'btn btn-link text-decoration-none text-muted small p-0';
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Resend OTP';

            startTicking();

            showModal('bi-envelope-check', 'info', 'OTP Sent!',
                'A new OTP has been sent to your email. Please check your inbox.');
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Resend OTP';
            showModal('bi-exclamation-circle', 'danger', 'Failed to Resend',
                data.error || 'Could not send OTP. Please try again.');
        }
    })
    .catch(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Resend OTP';
        showModal('bi-wifi-off', 'danger', 'Network Error',
            'Could not reach the server. Please check your connection and try again.');
    });
});

// ── Custom modal helper ───────────────────────────────────────────────
function showModal(icon, type, title, message) {
    const colorMap = {
        warning: { bg: 'bg-warning-subtle', text: 'text-warning', bar: '#F59E0B' },
        danger:  { bg: 'bg-danger-subtle',  text: 'text-danger',  bar: '#EF4444' },
        info:    { bg: 'bg-success-subtle', text: 'text-success', bar: '#22C55E' },
    };
    const c = colorMap[type] || colorMap.info;
    document.getElementById('customModalIcon').className = `bi ${icon} fs-2 ${c.text}`;
    document.getElementById('customModalIconWrap').className = `mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle ${c.bg}`;
    document.getElementById('customModalBar').style.background = c.bar;
    document.getElementById('customModalTitle').textContent = title;
    document.getElementById('customModalMessage').textContent = message;
    const modal = new bootstrap.Modal(document.getElementById('customAlertModal'));
    modal.show();
}

// ── Countdown timer — uses real server expiry, survives refresh ───────
(function () {
    const countdownEl = document.getElementById('otpCountdown');
    const timerBox    = document.getElementById('otpTimerBox');
    const timerIcon   = document.getElementById('otpTimerIcon');

    const serverExpiry = <%= otpExpiryTs ? otpExpiryTs : 'null' %>;
    const STORAGE_KEY  = 'otp_expiry_<%= encodeURIComponent(email) %>';

    let expiryMs;
    if (serverExpiry) {
        expiryMs = serverExpiry;
        sessionStorage.setItem(STORAGE_KEY, expiryMs);
    } else {
        const stored = sessionStorage.getItem(STORAGE_KEY);
        expiryMs = stored ? parseInt(stored, 10) : (Date.now() + 10 * 60 * 1000);
        if (!stored) sessionStorage.setItem(STORAGE_KEY, expiryMs);
    }

    let timerId = null;

    function markExpired() {
        if (timerId) clearTimeout(timerId);
        if (countdownEl) countdownEl.textContent = 'Expired';
        if (timerBox) {
            timerBox.style.background = '#fef2f2';
            timerBox.style.borderColor = '#fca5a5';
        }
        if (timerIcon) {
            timerIcon.className = 'bi bi-x-circle';
            timerIcon.style.color = '#ef4444';
        }
        const span = timerBox ? timerBox.querySelector('span') : null;
        if (span) span.style.color = '#991b1b';
        sessionStorage.removeItem(STORAGE_KEY);

        const resendBtn = document.getElementById('resendOtpBtn');
        if (resendBtn) {
            resendBtn.disabled = false;
            resendBtn.className = 'btn btn-warning btn-sm rounded-pill px-3 fw-semibold';
            resendBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Resend OTP';
        }
    }

    function updateDisplay() {
        const remaining = Math.max(0, Math.floor((expiryMs - Date.now()) / 1000));
        if (remaining <= 0) { markExpired(); return; }

        const m = Math.floor(remaining / 60).toString().padStart(2, '0');
        const s = (remaining % 60).toString().padStart(2, '0');
        if (countdownEl) countdownEl.textContent = `${m}:${s}`;

        // Under 2 minutes — turn orange/red
        if (remaining <= 120) {
            if (timerBox) { timerBox.style.background = '#fff1f2'; timerBox.style.borderColor = '#fca5a5'; }
            if (timerIcon) { timerIcon.className = 'bi bi-exclamation-circle'; timerIcon.style.color = '#ef4444'; }
            const span = timerBox ? timerBox.querySelector('span') : null;
            if (span) span.style.color = '#991b1b';
        }
    }

    function startTicking() {
        if (timerId) clearTimeout(timerId);
        updateDisplay();
        function tick() {
            const remaining = Math.max(0, Math.floor((expiryMs - Date.now()) / 1000));
            if (remaining <= 0) { markExpired(); return; }
            updateDisplay();
            timerId = setTimeout(tick, 1000);
        }
        timerId = setTimeout(tick, 1000);
    }

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') {
            if (Date.now() >= expiryMs) { markExpired(); }
            else { startTicking(); }
        } else {
            if (timerId) clearTimeout(timerId);
        }
    });

    if (Date.now() >= expiryMs) { markExpired(); }
    else { startTicking(); }
})();
</script>

<!-- ── Custom Alert Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="customAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Coloured top bar -->
            <div id="customModalBar" style="height:5px;"></div>
            <div class="modal-body p-4 text-center">
                <div id="customModalIconWrap"
                     style="width:64px;height:64px;">
                    <i id="customModalIcon"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2" id="customModalTitle"></h5>
                <p class="text-muted mb-0" style="font-size:0.9rem;" id="customModalMessage"></p>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 justify-content-center">
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold"
                        data-bs-dismiss="modal">
                    <i class="bi bi-check-lg me-1"></i> Got it
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer', { title: 'Reset Password' }) %>
