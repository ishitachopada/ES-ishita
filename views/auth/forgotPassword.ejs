<%- include('../partials/header', { title: 'Forgot Password', messages: typeof messages !== 'undefined' ? messages : {}, user: null }) %>

<div class="auth-split-container">

    <!-- LEFT SIDEBAR -->
    <div class="auth-sidebar-panel d-none d-lg-flex">
        <div class="mb-5">
            <i class="bi bi-mortarboard-fill text-white" style="font-size:3.25rem;"></i>
            <h2 class="text-white mt-3 fw-bold display-6">ExamSystem</h2>
            <p class="lead opacity-75">Secure, robust, and intuitive examination environment for global educators and students.</p>
        </div>
        <div class="mt-4">
            <div class="d-flex align-items-start gap-3 mb-4">
                <i class="bi bi-shield-lock fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">Secure Reset</h5>
                    <p class="mb-0 small text-white-50">OTP-based password reset keeps your account safe at all times.</p>
                </div>
            </div>
            <div class="d-flex align-items-start gap-3 mb-4">
                <i class="bi bi-envelope-check fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">Email Verification</h5>
                    <p class="mb-0 small text-white-50">A one-time code is sent to your registered email address.</p>
                </div>
            </div>
            <div class="d-flex align-items-start gap-3">
                <i class="bi bi-clock fs-2 text-white opacity-90 mt-1"></i>
                <div>
                    <h5 class="mb-1 fw-semibold text-white">10-Minute Expiry</h5>
                    <p class="mb-0 small text-white-50">OTPs expire automatically for maximum security.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT FORM PANEL -->
    <div class="auth-form-panel mx-auto">
        <div class="auth-form-wrapper pb-4">

            <!-- Icon -->
            <div class="text-center mb-4">
                <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle bg-primary mb-3"
                     style="width:64px;height:64px;">
                    <i class="bi bi-key-fill text-white fs-3"></i>
                </div>
                <h3 class="fw-bold mb-1">Forgot Password?</h3>
                <p class="text-muted small">Enter your registered email and we'll send you a reset OTP.</p>
            </div>

            <form action="/forgot-password" method="POST" id="forgotForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="mb-4">
                    <label for="email" class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" class="form-control" id="email" name="email"
                               placeholder="Enter your registered email" required autofocus>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3 fw-semibold" id="sendOtpBtn">
                    <i class="bi bi-send me-2"></i>Send OTP
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('forgotForm').addEventListener('submit', function () {
    const btn = document.getElementById('sendOtpBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending OTP...';
});
</script>

<%- include('../partials/footer', { title: 'Forgot Password' }) %>
