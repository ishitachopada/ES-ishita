<%- include('./partials/header', { title: '404 - Not Found' }) %>

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm p-5 bg-white">
            <div class="stat-icon accent-danger mx-auto mb-4" style="width: 80px; height: 80px; border-radius: 50%;">
                <i class="bi bi-exclamation-diamond fs-1"></i>
            </div>
            <h1 class="display-3 fw-bold text-dark mb-2">404</h1>
            <h4 class="fw-bold mb-3 text-dark">Page Not Found</h4>
            <p class="text-muted mb-4 lead">The workspace page you are trying to view does not exist or has been relocated by an administrator.</p>
            <a class="btn btn-primary btn-sm px-4 py-2 rounded-pill mx-auto d-inline-flex align-items-center gap-2" href="/">
                <i class="bi bi-house-door-fill"></i> Go back home
            </a>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
