<%- include('../partials/header', { title: 'Invalidated Submissions' }) %>

<div class="row g-4">
    <!-- PAGE HEADER -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8">
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-shield-exclamation-fill text-danger me-2"></i>Invalidated Submissions</h3>
                    <p class="text-muted small mb-0">List of student attempts locked or voided due to proctoring breaches or visibility changes.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <a href="/admin/exam-reports" class="btn btn-outline-primary btn-sm px-3 rounded-pill"><i class="bi bi-bar-chart-fill me-1"></i> Reports</a>
                </div>
            </div>
        </div>
    </div>

    <!-- METRICS CARDS -->
    <div class="col-12">
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-danger">
                    <span class="stat-icon accent-danger" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-exclamation-triangle-fill"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Total Invalidated</span>
                        <div class="stat-value fs-5 text-dark"><%= submissions ? submissions.length : 0 %></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-warning">
                    <span class="stat-icon accent-warning" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-clock-history"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Most Recent Void</span>
                        <div class="stat-value fs-5 text-dark">
                            <% if (submissions && submissions.length) { %>
                                <%= new Date(submissions[0].submittedAt || Date.now()).toLocaleDateString() %>
                            <% } else { %>—<% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER CARDS -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Search Student / Exam</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="invSearch" type="text" class="form-control border-start-0 bg-light" placeholder="Search by details...">
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Filter by Subject Domain</label>
                    <select id="invSubject" class="form-select bg-light">
                        <option value="">All Subjects</option>
                        <% const subjectsSet = new Set(); (submissions||[]).forEach(s => { if (s.exam && s.exam.subject) subjectsSet.add(s.exam.subject); });
                           Array.from(subjectsSet).forEach(sub => { %>
                            <option value="<%= sub %>"><%= sub %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- LOGS TABLE -->
    <div class="col-12">
        <div class="card table-card border-0 shadow-sm bg-white">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold text-dark">Lockout / Voided Attempts Log</h5>
            </div>
            
            <div class="table-responsive">
                <% if (!submissions || submissions.length === 0) { %>
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-shield-check-fill fs-2 text-success mb-2 d-block"></i>
                        No invalidated attempts recorded. Proctoring logs are clean!
                    </div>
                <% } else { %>
                    <table class="table table-hover align-middle mb-0" id="invTable">
                        <thead>
                            <tr class="table-light">
                                <th class="py-3 px-4">Student Examinee</th>
                                <th class="py-3">Exam Title</th>
                                <th class="py-3">Subject</th>
                                <th class="py-3">Proctoring Tag</th>
                                <th class="py-3">Voided Timestamp</th>
                                <th class="py-3 px-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% submissions.forEach(s => { %>
                                <tr data-subject="<%= s.exam && s.exam.subject ? s.exam.subject : '' %>">
                                    <td class="px-4">
                                        <span class="fw-bold text-dark"><%= s.student ? (s.student.username || s.student.email) : '-' %></span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark"><%= s.exam ? s.exam.title : '-' %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-semibold"><%= s.exam && s.exam.subject ? s.exam.subject : '-' %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger-subtle text-danger fw-semibold text-uppercase">Voided</span>
                                    </td>
                                    <td class="text-muted small">
                                        <%= s.submittedAt ? new Date(s.submittedAt).toLocaleString() : '-' %>
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/admin/exam-reports/<%= s._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-eye-fill"></i> View</a>
                                            <form action="/admin/exam-reports/reset/<%= s._id %>" method="POST" onsubmit="return confirm('Reset this submission to allow retake?')">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button class="btn btn-sm btn-warning text-dark rounded-pill px-3" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const qEl = document.getElementById('invSearch');
    const subjEl = document.getElementById('invSubject');
    const rows = document.querySelectorAll('#invTable tbody tr');
    
    function apply(){
        const q = (qEl.value || '').toLowerCase();
        const subj = subjEl.value || '';
        rows.forEach(tr => {
            const text = tr.innerText.toLowerCase();
            const okText = text.includes(q);
            const okSubj = !subj || (tr.getAttribute('data-subject') === subj);
            tr.style.display = (okText && okSubj) ? '' : 'none';
        });
    }
    
    if (qEl) qEl.addEventListener('input', apply);
    if (subjEl) subjEl.addEventListener('change', apply);

    // Live Socket Updates
    try {
        const socket = io();
        socket.on('connect', function(){ socket.emit('join-admin'); });
        socket.on('reports:update', function(payload){
            if (!payload || (payload.type !== 'invalidated' && payload.type !== 'reset')) return;
            location.reload();
        });
    } catch(e) {}
});
</script>

<%- include('../partials/footer') %>
