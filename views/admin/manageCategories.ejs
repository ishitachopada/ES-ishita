<%- include('../partials/header', { title: 'Manage Categories', messages: typeof messages !== 'undefined' ? messages : {}, user: typeof user !== 'undefined' ? user : null }) %>

<div class="row g-4">
    <!-- HEADER -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-tags text-primary me-2"></i>Assessment Categories</h3>
                    <p class="text-muted small mb-0">Group your exams by academic topics or departments.</p>
                </div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 text-uppercase fs-6">Total: <%= categories.length %></span>
            </div>
        </div>
    </div>

    <!-- FORM AND TABLE COLUMNS -->
    <div class="col-12 col-lg-4">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-plus-circle text-primary me-2"></i>Add Category</h5>
            <form action="/admin/manage-categories" method="POST" class="d-flex flex-column gap-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="form-label text-muted small fw-bold text-uppercase">Category Name</label>
                    <input name="name" class="form-control bg-light" placeholder="e.g. Science" required />
                </div>
                <div>
                    <label class="form-label text-muted small fw-bold text-uppercase">Description <span class="text-muted">(Optional)</span></label>
                    <textarea name="description" class="form-control bg-light" rows="3" placeholder="Define category scope..."></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm flex-grow-1 rounded-pill"><i class="bi bi-check-circle me-1"></i> Save</button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill" type="reset">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card table-card border-0 shadow-sm bg-white">
            <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-between">
                <h5 class="mb-0 fw-bold text-dark">Category Directory</h5>
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="catSearch" class="form-control border-start-0" placeholder="Search by name...">
                </div>
            </div>

            <div class="table-responsive">
                <% if (categories.length === 0) { %>
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-tags-fill fs-2 d-block mb-2 text-muted"></i>
                        No categories created yet. Compose your first one.
                    </div>
                <% } else { %>
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="table-light">
                                <th class="py-3 px-4">Category Name</th>
                                <th class="py-3">Description / Scope</th>
                                <th class="py-3 px-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="catTableBody">
                            <% categories.forEach(cat => { %>
                                <tr>
                                    <td class="px-4"><span class="fw-bold text-dark"><%= cat.name %></span></td>
                                    <td class="text-muted small"><%= cat.description || '—' %></td>
                                    <td class="text-end px-4">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/admin/edit-category/<%= cat._id %>" class="btn btn-sm btn-outline-secondary px-2.5 rounded-pill"><i class="bi bi-pencil-fill"></i></a>
                                            <a href="/admin/delete-category/<%= cat._id %>" class="btn btn-sm btn-outline-danger px-2.5 rounded-pill" onclick="return confirm('Delete category? All exams inside will lose reference.')"><i class="bi bi-trash-fill"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('catSearch');
    const rows = document.querySelectorAll('#catTableBody tr');
    if (input) {
        input.addEventListener('input', function(){
            const q = this.value.toLowerCase();
            rows.forEach(tr => {
                const text = tr.cells[0]?.textContent.toLowerCase() || '';
                tr.style.display = text.includes(q) ? '' : 'none';
            });
        });
    }

    try {
        const socket = io();
        socket.on('connect', function(){ socket.emit('join-admin'); });
        socket.on('categories:update', function(){ location.reload(); });
    } catch(e) {}
});
</script>

<%- include('../partials/footer') %>