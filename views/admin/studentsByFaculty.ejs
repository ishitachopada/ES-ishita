<%- include('../partials/header', { title: 'Students by Faculty' }) %>

<div class="row g-4">
    <!-- PAGE HEADER -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row align-items-center g-3">
                <div class="col-12">
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-person-check text-primary me-2"></i>Student Assignments</h3>
                    <p class="text-muted small mb-0">Associate students with specific faculty advisors for personalized monitoring.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ASSIGN FORM -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-link-45deg text-primary me-2"></i>Assign Student to Advisor</h5>
            <form action="/admin/assign-student-faculty" method="POST" class="row g-3 align-items-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-5 col-12">
                    <label class="form-label text-muted small fw-bold text-uppercase">Select Student</label>
                    <select name="studentId" class="form-select bg-light" required>
                        <% Object.keys(groups).forEach(fid => { %>
                            <% groups[fid].forEach(s => { %>
                                <option value="<%= s._id %>"><%= s.username %> (<%= s.email %>)</option>
                            <% }) %>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-5 col-12">
                    <label class="form-label text-muted small fw-bold text-uppercase">Select Faculty Advisor</label>
                    <select name="facultyId" class="form-select bg-light">
                        <option value="">-- Unassigned (None) --</option>
                        <% facultyList.forEach(f => { %>
                            <option value="<%= f._id %>"><%= f.username %> - <%= f.department || 'Advising' %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-2 col-12 d-grid">
                    <button class="btn btn-primary btn-sm py-2 rounded-pill" type="submit"><i class="bi bi-link-45deg"></i> Link Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FACULTY COLLATED CARDS -->
    <div class="col-12 mt-2">
        <div class="row g-3">
            <% facultyList.forEach(f => { %>
                <div class="col-12 col-md-6">
                    <div class="card h-100 table-card border-0 shadow-sm bg-white">
                        <div class="card-header bg-white border-bottom py-3">
                            <h5 class="mb-0 fw-bold text-dark">
                                <i class="bi bi-person-badge text-primary me-2"></i><%= f.username %>
                                <span class="badge bg-primary-subtle text-primary fw-semibold ms-1" style="font-size: 0.75rem;"><%= f.department || 'General Department' %></span>
                            </h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr class="table-light">
                                        <th class="py-2 px-3">Student</th>
                                        <th class="py-2">Email</th>
                                        <th class="py-2 px-3">Registered</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% (groups[String(f._id)] || []).forEach(s => { %>
                                        <tr>
                                            <td class="px-3"><span class="fw-bold text-dark"><%= s.username %></span></td>
                                            <td class="text-muted small"><%= s.email %></td>
                                            <td class="text-muted small px-3"><%= new Date(s.createdAt).toLocaleDateString([], {day: '2-digit', month: 'short', year: 'numeric'}) %></td>
                                        </tr>
                                    <% }) %>
                                    <% if (!(groups[String(f._id)] || []).length) { %>
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted small">No students assigned.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            <% }) %>

            <!-- UNASSIGNED STUDENTS CARD -->
            <div class="col-12 col-md-6">
                <div class="card h-100 table-card border-0 shadow-sm bg-white" style="border: 1px dashed var(--border-color) !important;">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-person-x text-muted me-2"></i>Unassigned Directory
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="table-light">
                                    <th class="py-2 px-3">Student</th>
                                    <th class="py-2">Email</th>
                                    <th class="py-2 px-3">Registered</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% (groups['unassigned'] || []).forEach(s => { %>
                                    <tr>
                                        <td class="px-3"><span class="fw-bold text-dark"><%= s.username %></span></td>
                                        <td class="text-muted small"><%= s.email %></td>
                                        <td class="text-muted small px-3"><%= new Date(s.createdAt).toLocaleDateString([], {day: '2-digit', month: 'short', year: 'numeric'}) %></td>
                                    </tr>
                                <% }) %>
                                <% if (!(groups['unassigned'] || []).length) { %>
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted small">All students assigned!</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
