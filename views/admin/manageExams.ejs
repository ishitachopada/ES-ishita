<%- include('../partials/header', { title: 'Manage Exams' }) %>

<div class="row g-4">
    <!-- PAGE HEADER CARD -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8">
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Manage Assessment Library</h3>
                    <p class="text-muted small mb-0">Create, edit, activate, and toggle reveal options for students.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <div class="d-inline-flex gap-2">
                        <a href="/admin/create-exam" class="btn btn-primary btn-sm px-3 rounded-pill" id="btnCreateExam">
                            <i class="bi bi-plus-circle-fill me-1"></i> Create Exam
                        </a>
                        <a href="/admin/exam-reports" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                            <i class="bi bi-bar-chart-fill me-1"></i> Reports
                        </a>
                    </div>
                </div>
            </div>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </div>
    </div>

    <!-- FILTER & TABLE CARD -->
    <div class="col-12">
        <div class="card table-card border-0 shadow-sm bg-white">
            <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-between">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm active px-3 rounded-pill" data-filter="">All</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" data-filter="active">Active</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" data-filter="inactive">Inactive</button>
                </div>
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="examSearch" class="form-control border-start-0" placeholder="Search by title, subject, category...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="table-light">
                            <th class="py-3 px-4">Exam Details</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Metrics</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Author</th>
                            <th class="py-3 px-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="examTableBody">
                        <% if (exams.length === 0) { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-2 d-block mb-2 text-muted"></i>
                                    No assessments found in the library. Click "Create Exam" to add one.
                                </td>
                            </tr>
                        <% } else { %>
                            <% exams.forEach(exam => { %>
                                <tr data-status="<%= exam.isActive ? 'active' : 'inactive' %>">
                                    <td class="px-4">
                                        <div class="fw-bold text-dark mb-1"><%= exam.title %></div>
                                        <span class="text-muted small text-truncate d-block" style="max-width: 250px;"><%= exam.description %></span>
                                    </td>
                                    <td>
                                        <% if (exam.category) { %>
                                            <span class="badge bg-primary-subtle text-primary fw-semibold"><%= exam.category.name %></span>
                                        <% } else { %>
                                            <span class="text-muted small">-</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="small text-dark fw-bold"><%= exam.questions.length %> Questions</div>
                                        <span class="text-muted small" style="font-size:0.75rem;"><%= exam.duration %> Minutes</span>
                                    </td>
                                    <td>
                                        <% if (exam.isActive) { %>
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="small text-dark fw-semibold"><%= exam.createdBy ? exam.createdBy.username : 'Administrator' %></span>
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="d-flex flex-column align-items-end gap-2">
                                            <div class="form-check form-switch text-start">
                                                <input class="form-check-input reveal-toggle-btn" type="checkbox" role="switch"
                                                       id="reveal-<%= exam._id %>" <%= exam.revealAnswersToStudents ? 'checked' : '' %>
                                                       data-exam-id="<%= exam._id %>">
                                                <label class="form-check-label small text-muted" for="reveal-<%= exam._id %>">
                                                    Reveal Answers
                                                </label>
                                            </div>
                                            <div class="d-flex gap-1 justify-content-end">
                                                <a href="/admin/toggle-exam/<%= exam._id %>" 
                                                   class="btn btn-xs <%= exam.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> py-1 px-2.5 rounded-pill toggle-exam-btn"
                                                   data-action="<%= exam.isActive ? 'deactivate' : 'activate' %>"
                                                   style="font-size: 0.75rem;">
                                                    <i class="bi bi-<%= exam.isActive ? 'pause-fill' : 'play-fill' %>"></i>
                                                    <%= exam.isActive ? 'Pause' : 'Play' %>
                                                </a>
                                                <a href="/admin/assign-exam/<%= exam._id %>" class="btn btn-xs btn-outline-info py-1 px-2.5 rounded-pill" style="font-size: 0.75rem;">
                                                    <i class="bi bi-person-check-fill"></i> Assign
                                                </a>
                                                <a href="/admin/edit-exam/<%= exam._id %>" class="btn btn-xs btn-outline-secondary py-1 px-2.5 rounded-pill" style="font-size: 0.75rem;">
                                                    <i class="bi bi-pencil-fill"></i> Edit
                                                </a>
                                                <a href="/admin/exam-reports" class="btn btn-xs btn-outline-primary py-1 px-2.5 rounded-pill" style="font-size: 0.75rem;">
                                                    <i class="bi bi-bar-chart-fill"></i> Reports
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
  (function(){
    try {
      const socket = (typeof window !== 'undefined' && window.__appSocket) ? window.__appSocket : io();
      socket.on('connect', function(){ socket.emit('join-admin'); });
      socket.on('exams:update', function(payload){ 
          if (payload && payload.type === 'reveal') {
              const toggleBtn = document.querySelector(`.reveal-toggle-btn[data-exam-id="${payload.examId}"]`);
              if (toggleBtn && toggleBtn.checked !== payload.reveal) {
                  toggleBtn.checked = payload.reveal;
              }
              return;
          }
          location.reload(); 
      });
    } catch(e) {}
    
    // Filtering logic
    const search = document.getElementById('examSearch');
    const filterBtns = Array.from(document.querySelectorAll('[data-filter]'));
    let filter = '';
    
    function apply() {
      const q = (search && search.value || '').toLowerCase();
      document.querySelectorAll('#examTableBody tr').forEach(tr => {
        const text = tr.innerText.toLowerCase();
        const st = tr.getAttribute('data-status') || '';
        const okText = !q || text.includes(q);
        const okStatus = !filter || st === filter;
        tr.style.display = okText && okStatus ? '' : 'none';
      });
    }
    
    if (search) search.addEventListener('input', apply);
    filterBtns.forEach(btn => btn.addEventListener('click', function(){
      filterBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      filter = this.getAttribute('data-filter');
      apply();
    }));
  })();

    // CSP-compliant event listeners
    document.querySelectorAll('.reveal-toggle-btn').forEach(btn => {
      btn.addEventListener('change', function() {
        toggleRevealExam(this.getAttribute('data-exam-id'), this);
      });
    });

    document.querySelectorAll('.toggle-exam-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        if (!confirm('Are you sure you want to ' + this.dataset.action + ' this exam?')) {
          e.preventDefault();
        }
      });
    });

  // Toggle reveal state AJAX
  async function toggleRevealExam(examId, checkboxEl) {
    try {
      checkboxEl.disabled = true;
      const res = await fetch(`/admin/exams/${examId}/toggle-reveal`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 
            'Content-Type': 'application/json', 
            'Accept': 'application/json',
            'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
        },
        body: JSON.stringify({ reveal: checkboxEl.checked })
      });
      if (!res.ok) { checkboxEl.checked = !checkboxEl.checked; return; }
      const data = await res.json().catch(() => null);
      if (!data || !data.ok) checkboxEl.checked = !checkboxEl.checked;
    } catch (e) {
      checkboxEl.checked = !checkboxEl.checked;
    } finally {
      checkboxEl.disabled = false;
    }
  }
</script>

<%- include('../partials/footer') %>