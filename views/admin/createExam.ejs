<%- include('../partials/header', { title: 'Create Exam' }) %>

<div class="row g-4">
    <!-- PAGE HEADER -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8">
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Create New Assessment</h3>
                    <p class="text-muted small mb-0">Compose questions manually or import structured MCQ Excel lists.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <a href="/admin/manage-exams" class="btn btn-outline-primary btn-sm px-3 rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Library</a>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN FORM -->
    <div class="col-12">
        <form id="examForm" action="/admin/create-exam?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="row g-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- LEFT BLOCK: ASSESSMENTS CONFIG & QUESTIONS -->
            <div class="col-lg-8">
                <!-- Details Card -->
                <div class="card p-4 mb-4 border-0 shadow-sm bg-white">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Assessment Configurations</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="subject" class="form-label text-muted small fw-bold text-uppercase">Subject Domain</label>
                            <input type="text" class="form-control bg-light" id="subject" name="subject" placeholder="e.g. Computer Science">
                        </div>
                        <div class="col-md-6">
                            <label for="category" class="form-label text-muted small fw-bold text-uppercase">Category Group</label>
                            <select class="form-select bg-light" id="category" name="category">
                                <option value="">-- Select Category --</option>
                                <% if (typeof categories !== 'undefined') { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>"><%= cat.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="title" class="form-label text-muted small fw-bold text-uppercase">Exam Title</label>
                            <input type="text" class="form-control bg-light" id="title" name="title" placeholder="e.g. Final Term Quiz" required>
                        </div>
                        <div class="col-12">
                            <label for="description" class="form-label text-muted small fw-bold text-uppercase">Instructions / Description</label>
                            <textarea class="form-control bg-light" id="description" name="description" rows="3" placeholder="Provide general guidelines for examinees..." required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="duration" class="form-label text-muted small fw-bold text-uppercase">Duration Limit (Minutes)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-clock text-muted"></i></span>
                                <input type="number" class="form-control border-start-0 bg-light" id="duration" name="duration" min="1" placeholder="60" required>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="revealAnswersToStudents" name="revealAnswersToStudents">
                                <label class="form-check-label text-muted small" for="revealAnswersToStudents">Reveal correct answers to students in scorecard</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Questions Card Wrapper -->
                <div class="card p-4 border-0 shadow-sm bg-white">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-task text-primary me-2"></i>Question Manager</h5>
                        <button type="button" class="btn btn-success btn-sm px-3 rounded-pill" onclick="addQuestion()">
                            <i class="bi bi-plus-lg me-1"></i> Add Question
                        </button>
                    </div>

                    <!-- EXCEL IMPORT SPLIT ZONE -->
                    <div class="border border-dashed border-primary rounded p-4 text-center bg-light mb-4">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-success fs-1 mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">Import structured MCQs via Spreadsheet</h6>
                        <p class="text-muted small mb-3">Save time by importing large question lists instantly from CSV/Excel sheets.</p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" href="/admin/download-mcq-template">
                                <i class="bi bi-download me-1"></i> Download Template CSV
                            </a>
                            <label class="btn btn-outline-primary btn-sm mb-0 rounded-pill px-3">
                                <i class="bi bi-upload me-1"></i> Import Spreadsheet File
                                <input type="file" id="mcqExcel" accept=".xlsx,.xls,.csv" hidden>
                            </label>
                        </div>
                    </div>

                    <div id="questionsContainer" class="d-flex flex-column gap-3">
                        <!-- Questions injected dynamically -->
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: GUIDELINES -->
            <div class="col-lg-4">
                <div class="sticky-top sidebar-sticky-panel" style="top: calc(var(--topbar-height) + 1.5rem); z-index:1000;">
                    <div class="card p-4 border-0 shadow-sm bg-white mb-4">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-book text-primary me-2"></i>Guidelines</h5>
                        <ul class="d-flex flex-column gap-2 text-muted small p-0 ps-3 mb-4">
                            <li>Set a clear subject, category, and time duration.</li>
                            <li><strong>MCQ</strong> type: specify 4 options and select the correct A-D index dropdown.</li>
                            <li><strong>Open-ended</strong> type: supply comma-separated accepted keywords for fuzzy matching auto-grade.</li>
                            <li><strong>Image Question</strong> type: upload a reference image to prompt students.</li>
                        </ul>
                        <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i> Publish Assessment
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
let questionCount = 0;

function buildMcqOptionsHtml(idx) {
    return [0, 1, 2, 3].map(i => `
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted fw-bold">${String.fromCharCode(65 + i)}</span>
                <input type="text" class="form-control border-start-0 bg-light" name="questions[${idx}][options][${i}]" placeholder="Option text">
            </div>
        </div>
    `).join('');
}

function addQuestion() {
    questionCount++;
    const idx = questionCount - 1;
    const questionHtml = `
        <div class="card shadow-sm border border-light p-3 position-relative bg-white" id="question-${questionCount}">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <span class="fw-bold text-dark" style="font-size:0.875rem;">Question ${questionCount}</span>
                <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removeQuestion(${questionCount})">
                    <i class="bi bi-trash-fill fs-5"></i>
                </button>
            </div>
            
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Question Prompt</label>
                <input type="text" class="form-control bg-light" name="questions[${idx}][text]" placeholder="Enter question..." required>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Question Type</label>
                    <select class="form-select bg-light" name="questions[${idx}][type]" onchange="toggleOptions(this)" data-qid="${idx}">
                        <option value="mcq">Multiple Choice (MCQ)</option>
                        <option value="open">Open-ended</option>
                        <option value="image">Image Question</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Question Points</label>
                    <input type="number" class="form-control bg-light" name="questions[${idx}][points]" value="1" min="1">
                </div>
            </div>

            <div class="mb-3 question-options" id="options-${idx}">
                <label class="form-label text-muted small fw-bold text-uppercase">Multiple Choice Options</label>
                <div class="row g-2">
                    ${buildMcqOptionsHtml(idx)}
                </div>
            </div>

            <div class="mb-3 question-image" id="image-${idx}" style="display:none;">
                <label class="form-label text-muted small fw-bold text-uppercase">Reference Image Upload</label>
                <input type="file" accept="image/*" class="form-control bg-light" data-qid="${idx}" onchange="encodeImageToBase64(this)">
                <input type="hidden" name="questions[${idx}][imageBase64]" id="img64-${idx}">
                <div class="mt-2">
                    <img id="preview-${idx}" src="" alt="Preview" style="max-width: 100%; display: none;" class="img-fluid rounded border shadow-sm">
                </div>
            </div>

            <div class="mb-3 question-answers" id="answers-${idx}" style="display:none;">
                <label class="form-label text-muted small fw-bold text-uppercase">Fuzzy Grade Keywords (Comma-separated)</label>
                <input type="text" class="form-control bg-light" name="questions[${idx}][acceptedAnswers]" placeholder="e.g. mitosis, mito sis">
                <span class="form-text text-muted small" style="font-size:0.75rem;">Fuzzy matches responses scoring >=75% similarity.</span>
            </div>

            <div class="mb-2" id="correct-wrapper-${idx}">
                <label class="form-label text-muted small fw-bold text-uppercase">Correct Option</label>
                <select class="form-select bg-light" name="questions[${idx}][correctAnswer]" id="correct-${idx}">
                    <option value="">-- Choose correct MCQ option --</option>
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </div>
        </div>
    `;
    document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', questionHtml);
    const sel = document.querySelector(`select[name="questions[${idx}][type]"]`);
    if (sel) toggleOptions(sel);
}

function removeQuestion(id) {
    if (confirm('Are you sure you want to remove this question?')) {
        document.getElementById(`question-${id}`).remove();
    }
}

addQuestion();

function toggleOptions(selectEl) {
    const qid = selectEl.dataset.qid;
    const val = selectEl.value;
    const optionsDiv = document.getElementById(`options-${qid}`);
    const correctSel = document.getElementById(`correct-${qid}`);
    const correctWrap = document.getElementById(`correct-wrapper-${qid}`);
    const imageDiv = document.getElementById(`image-${qid}`);
    const ansDiv = document.getElementById(`answers-${qid}`);
    
    if (val === 'open') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = false; i.value = ''; });
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = '';
    } else if (val === 'mcq') {
        if (optionsDiv) optionsDiv.style.display = '';
        if (correctSel) { correctSel.disabled = false; correctSel.required = true; }
        if (correctWrap) correctWrap.style.display = '';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = true; });
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = 'none';
    } else if (val === 'image') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; correctSel.value = ''; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = false; i.value = ''; });
        if (imageDiv) imageDiv.style.display = '';
        if (ansDiv) ansDiv.style.display = '';
    }
}

function encodeImageToBase64(inputEl) {
    const file = inputEl.files && inputEl.files[0];
    const qid = inputEl.getAttribute('data-qid');
    if (!file || !qid) return;
    const reader = new FileReader();
    reader.onload = function(e){
        const dataUrl = e.target.result;
        const hidden = document.getElementById(`img64-${qid}`);
        const prev = document.getElementById(`preview-${qid}`);
        if (hidden) hidden.value = dataUrl;
        if (prev) { prev.src = dataUrl; prev.style.display = ''; }
    };
    reader.readAsDataURL(file);
}

document.getElementById('mcqExcel').addEventListener('change', function(){
    const file = this.files && this.files[0];
    if (!file) return;
    const form = new FormData();
    form.append('mcqExcel', file);
    fetch('/admin/import-mcq-excel', { 
        method: 'POST', 
        body: form,
        headers: {
            'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
        }
    })
    .then(r => r.json())
    .then(data => {
        if (!data || !data.ok) {
            alert('Failed to import questions');
            return;
        }
        const qs = Array.isArray(data.questions) ? data.questions : [];
        if (qs.length === 0) { this.value = ''; return; }
        
        const firstText = document.querySelector('input[name="questions[0][text]"]');
        const firstBlank = firstText && !firstText.value.trim();
        if (firstBlank) {
            setQuestionFields(0, qs[0]);
            for (let i = 1; i < qs.length; i++) insertImportedQuestion(qs[i]);
        } else {
            qs.forEach(q => insertImportedQuestion(q));
        }
        this.value = '';
    })
    .catch(() => { alert('Upload failed'); this.value=''; });
});

function insertImportedQuestion(q) {
    addQuestion();
    const idx = questionCount - 1;
    setQuestionFields(idx, q);
}

function setQuestionFields(idx, q) {
    const textInput = document.querySelector(`input[name="questions[${idx}][text]"]`);
    const typeSelect = document.querySelector(`select[name="questions[${idx}][type]"]`);
    const pointsInput = document.querySelector(`input[name="questions[${idx}][points]"]`);
    if (textInput) textInput.value = q.text || '';
    if (typeSelect) { typeSelect.value = 'mcq'; toggleOptions(typeSelect); }
    if (Array.isArray(q.options)) {
        q.options.slice(0,4).forEach((opt, i) => {
            const optInput = document.querySelector(`input[name="questions[${idx}][options][${i}]"]`);
            if (optInput) optInput.value = String(opt);
        });
    }
    const correctSel = document.getElementById(`correct-${idx}`);
    if (correctSel && q.correctAnswer !== null && q.correctAnswer !== undefined) {
        correctSel.value = String(q.correctAnswer);
    }
    if (pointsInput) pointsInput.value = q.points || 1;
}
</script>

<%- include('../partials/footer') %>

<!-- Floating Action Button -->
<button type="button" class="fab-add-question" onclick="addQuestion()" title="Add Question">
    <i class="bi bi-plus-lg"></i>
</button>