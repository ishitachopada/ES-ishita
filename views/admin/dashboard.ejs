<%- include('../partials/header', { title: 'Admin Dashboard', activeNav: 'admin' }) %>

<% 
    const safeExams = exams || 0;
    const safeSubmissions = submissions || 0;
    const safeCategories = categories || 0;
    const totalRecent = Array.isArray(recentExams) ? recentExams.length : 0;
    const activeCount = Array.isArray(recentExams) ? recentExams.filter(e => e.isActive).length : 0;
    const inactiveCount = Math.max(totalRecent - activeCount, 0);
    const activeRatio = totalRecent ? Math.round((activeCount / totalRecent) * 100) : 0;
    const submissionRatio = safeExams ? Math.min(100, Math.round((safeSubmissions / safeExams) * 12)) : Math.min(100, safeSubmissions * 5);
    const categoryCoverage = safeExams ? Math.min(100, Math.round((safeCategories / safeExams) * 20) + 20) : Math.min(100, safeCategories * 8);
%>

<div class="row g-4">
    <!-- WELCOME & HERO BANNER (Admin Custom Green Gradient) -->
    <div class="col-12">
        <div class="dashboard-hero p-4 text-white rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" style="min-height: auto; background: linear-gradient(135deg, #1E3A8A 0%, #10B981 100%);">
            <div>
                <span class="badge bg-light text-success mb-2 fw-semibold px-2.5 py-1 text-uppercase" style="font-size:0.75rem;"><i class="bi bi-shield-lock me-1"></i> Admin Console</span>
                <h2 class="fw-bold mb-1 text-white">Welcome back, <%= user.username %>!</h2>
                <p class="mb-0 text-white-50 small">Manage your exam repository, view submissions, categories, and real-time statistics.</p>
            </div>
            
            <div class="bg-white bg-opacity-10 border border-white border-opacity-10 rounded p-3 text-start hero-side-card" style="backdrop-filter: blur(10px);">
                <div class="small text-white-50 fw-semibold text-uppercase tracking-wider mb-1"><i class="bi bi-speedometer2 me-1"></i> System Status</div>
                <div class="fw-bold text-white text-truncate" style="font-size: 0.95rem;">All Services Online</div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="badge bg-success text-white" style="font-size:0.75rem;"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Active Now</span>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS GRID -->
    <div class="col-12">
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-primary">
                    <span class="stat-icon accent-primary" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-journal-richtext"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Total Exams</span>
                        <div class="stat-value fs-5 text-dark"><%= safeExams %></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-success">
                    <span class="stat-icon accent-success" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-check2-all"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Submissions</span>
                        <div class="stat-value fs-5 text-dark"><%= safeSubmissions %></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-info">
                    <span class="stat-icon accent-info" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-tags"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Categories</span>
                        <div class="stat-value fs-5 text-dark"><%= safeCategories %></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="stat-card border-start border-4 border-warning">
                    <span class="stat-icon accent-warning" style="width:40px; height:40px; font-size:1.1rem;"><i class="bi bi-activity"></i></span>
                    <div class="stat-info">
                        <span class="stat-title text-uppercase tracking-wider" style="font-size:0.65rem;">Active Ratio</span>
                        <div class="stat-value fs-5 text-dark"><%= activeRatio %>%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHARTS SECTION -->
    <div class="col-12 col-lg-8" style="min-width: 0;">
        <div class="card p-4 border-0 shadow-sm bg-white h-100" style="overflow: hidden;">
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-graph-up text-primary me-2"></i>Students Growth</h5>
                    <p class="text-muted small mb-0">Active student registration curve over the last 6 months.</p>
                </div>
                <span class="badge bg-light text-secondary">Real-time logs</span>
            </div>
            <div class="chart-container chart-container-lg">
                <canvas id="adminStudentGrowthChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4" style="min-width: 0;">
        <div class="card p-4 border-0 shadow-sm bg-white h-100" style="overflow: hidden;">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-pie-chart text-primary me-2"></i>Exam Categories</h5>
                    <p class="text-muted small mb-0">Exams per category.</p>
                </div>
            </div>
            <div class="chart-container chart-container-lg">
                <canvas id="adminCategoryPieChart"></canvas>
            </div>
        </div>
    </div>

    <!-- COMMAND CENTER ACTIONS -->
    <div class="col-12 col-lg-7">
        <div class="card p-4 border-0 shadow-sm bg-white h-100">
            <div class="mb-4">
                <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-lightning-charge text-primary me-2"></i>Quick Commands</h5>
                <p class="text-muted small mb-0">Instant administrative shortcuts and workspace links.</p>
            </div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <a href="/admin/create-exam" class="btn-action">
                        <div>
                            <div class="fw-bold text-primary">Create New Exam</div>
                            <div class="text-muted small" style="font-size:0.75rem;">Build MCQs or import excel sheets</div>
                        </div>
                        <span class="cta-icon bg-light text-primary"><i class="bi bi-plus-lg"></i></span>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/admin/manage-exams" class="btn-action">
                        <div>
                            <div class="fw-bold text-primary">Manage Library</div>
                            <div class="text-muted small" style="font-size:0.75rem;">Activate/deactivate active exams</div>
                        </div>
                        <span class="cta-icon bg-light text-primary"><i class="bi bi-collection"></i></span>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/admin/manage-categories" class="btn-action">
                        <div>
                            <div class="fw-bold text-primary">Edit Categories</div>
                            <div class="text-muted small" style="font-size:0.75rem;">Adjust topics and tags</div>
                        </div>
                        <span class="cta-icon bg-light text-primary"><i class="bi bi-tag"></i></span>
                    </a>
                </div>
                <div class="col-sm-6">
                    <a href="/admin/exam-reports" class="btn-action">
                        <div>
                            <div class="fw-bold text-primary">Analyse Results</div>
                            <div class="text-muted small" style="font-size:0.75rem;">Grade submissions and review scores</div>
                        </div>
                        <span class="cta-icon bg-light text-primary"><i class="bi bi-bar-chart"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- INSIGHTS SPEEDOMETER -->
    <div class="col-12 col-lg-5">
        <div class="card p-4 border-0 shadow-sm bg-white h-100">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-activity text-primary me-2"></i>System snapshot</h5>
            <div class="d-flex flex-column gap-3 mt-2" style="font-size:0.875rem;">
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Assessment Output</span>
                        <span class="fw-bold text-dark"><%= submissionRatio %>%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-color);">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= submissionRatio %>%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Category Coverage</span>
                        <span class="fw-bold text-dark"><%= categoryCoverage %>%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-color);">
                        <div class="progress-bar bg-success" role="progressbar" style="width: <%= categoryCoverage %>%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Active Ratio</span>
                        <span class="fw-bold text-dark"><%= activeRatio %>%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: var(--border-color);">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: <%= activeRatio %>%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- EXAMS EXPLORER -->
    <div class="col-12 col-lg-8">
        <div class="card table-card border-0 shadow-sm bg-white">
            <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row gap-3 align-items-md-center justify-content-between">
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Recent Exam Assessments</h5>
                    <p class="text-muted small mb-0">List of last scheduled assessments.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="dashExamSearch" class="form-control border-start-0" placeholder="Search title...">
                    </div>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="table-light">
                            <th class="py-3 px-4">Exam Title</th>
                            <th class="py-3">Subject</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Questions</th>
                            <th class="py-3">Duration</th>
                            <th class="py-3 px-4">Status</th>
                        </tr>
                    </thead>
                    <tbody id="dashExamBody">
                        <% if (recentExams && recentExams.length > 0) { %>
                            <% recentExams.forEach(exam => { %>
                                <tr data-status="<%= exam.isActive ? 'active' : 'inactive' %>">
                                    <td class="fw-bold text-dark px-4"><%= exam.title %></td>
                                    <td><%= exam.subject || '-' %></td>
                                    <td>
                                        <% if (exam.category && exam.category.name) { %>
                                            <span class="badge bg-primary-subtle text-primary fw-semibold"><%= exam.category.name %></span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td><%= exam.questions.length %> Qs</td>
                                    <td><%= exam.duration %> min</td>
                                    <td class="px-4">
                                        <% if (exam.isActive) { %>
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No recent exams available.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RECENT ACTIVITY TIMELINE -->
    <div class="col-12 col-lg-4">
        <div class="card p-4 border-0 shadow-sm bg-white h-100">
            <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-clock-history text-primary me-2"></i>Recent Activity</h5>
            <% if (recentExams && recentExams.length > 0) { %>
                <div class="timeline" style="font-size:0.825rem;">
                    <% recentExams.forEach(exam => { %>
                        <div class="timeline-item <%= exam.isActive ? '' : 'inactive' %>">
                            <h6 class="mb-1 text-dark fw-semibold"><%= exam.title %></h6>
                            <p class="mb-0 text-muted small"><%= exam.subject || 'General' %> · <%= exam.questions.length %> Qs · <%= exam.duration %> Min</p>
                            <span class="text-muted small" style="font-size:0.75rem;"><%= new Date(exam.createdAt).toLocaleDateString([], {day: '2-digit', month: 'short', year: 'numeric'}) %></span>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-5 text-muted">No recent activities.</div>
            <% } %>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Search filter for recent exams table
    const searchInput = document.getElementById('dashExamSearch');
    const tableRows = document.querySelectorAll('#dashExamBody tr');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = searchInput.value.toLowerCase();
            tableRows.forEach(row => {
                const text = row.cells[0]?.textContent.toLowerCase() || '';
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }

    // Chart 1: Students Growth Chart (Area Chart)
    const ctxGrowth = document.getElementById('adminStudentGrowthChart').getContext('2d');
    new Chart(ctxGrowth, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: 'Registered Students',
                data: [32, 54, 76, 120, 150, 185],
                borderColor: '#2563EB',
                backgroundColor: 'rgba(37, 99, 235, 0.05)',
                borderWidth: 3,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { grid: { color: '#F1F5F9' }, ticks: { precision: 0 } },
                x: { grid: { display: false } }
            }
        }
    });

    // Chart 2: Category Pie Chart
    const ctxPie = document.getElementById('adminCategoryPieChart').getContext('2d');
    new Chart(ctxPie, {
        type: 'doughnut',
        data: {
            labels: ['Computer Science', 'General Science', 'Mathematics', 'Unassigned'],
            datasets: [{
                data: [12, 6, 8, 4],
                backgroundColor: ['#2563EB', '#22C55E', '#F59E0B', '#64748B'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
            }
        }
    });

    // Socket.io Real-time update listeners
    try {
        const socket = io();
        socket.on('connect', function(){ socket.emit('join-admin'); });
        socket.on('exams:update', function(){ location.reload(); });
        socket.on('categories:update', function(){ location.reload(); });
        socket.on('reports:update', function(){ location.reload(); });
    } catch(e) {}
});
</script>

<%- include('../partials/footer') %>