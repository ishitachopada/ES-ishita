<%- include('../partials/header', { title: 'Edit Exam' }) %>

<div class="row g-4">
    <!-- PAGE HEADER -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-white">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8">
                    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Exam Settings</h3>
                    <p class="text-muted small mb-0">Modify configuration details, edit existing questions, or append new questions.</p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <a href="/admin/manage-exams" class="btn btn-outline-primary btn-sm px-3 rounded-pill"><i class="bi bi-arrow-left me-1"></i> Back to Library</a>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM -->
    <div class="col-12">
        <form id="examForm" action="/admin/edit-exam/<%= exam._id %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="row g-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- LEFT BLOCK: EXAM DETAILS & QUESTIONS -->
            <div class="col-lg-8">
                <!-- Details Card -->
                <div class="card p-4 mb-4 border-0 shadow-sm bg-white">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-info-circle text-primary me-2"></i>Exam Parameters</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="subject" class="form-label text-muted small fw-bold text-uppercase">Subject Domain</label>
                            <input type="text" class="form-control bg-light" id="subject" name="subject" value="<%= exam.subject || '' %>" placeholder="e.g. Mathematics">
                        </div>
                        <div class="col-md-6">
                            <label for="category" class="form-label text-muted small fw-bold text-uppercase">Category Group</label>
                            <select class="form-select bg-light" id="category" name="category">
                                <option value="">-- Select Category --</option>
                                <% if (typeof categories !== 'undefined') { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat._id %>" <%= exam.category && (String(exam.category) === String(cat._id) || (exam.category._id && String(exam.category._id) === String(cat._id))) ? 'selected' : '' %>><%= cat.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="title" class="form-label text-muted small fw-bold text-uppercase">Exam Title</label>
                            <input type="text" class="form-control bg-light" id="title" name="title" value="<%= exam.title %>" required>
                        </div>
                        <div class="col-12">
                            <label for="description" class="form-label text-muted small fw-bold text-uppercase">Instructions / Description</label>
                            <textarea class="form-control bg-light" id="description" name="description" rows="3" required><%= exam.description %></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="duration" class="form-label text-muted small fw-bold text-uppercase">Duration Limit (Minutes)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-clock text-muted"></i></span>
                                <input type="number" class="form-control border-start-0 bg-light" id="duration" name="duration" min="1" value="<%= exam.duration %>" required>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="revealAnswersToStudents" name="revealAnswersToStudents" <%= exam.revealAnswersToStudents ? 'checked' : '' %>>
                                <label class="form-check-label text-muted small" for="revealAnswersToStudents">Allow students to see correct answers in results</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EDIT EXISTING QUESTIONS -->
                <div class="card p-4 mb-4 border-0 shadow-sm bg-white">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Existing Questions</h5>
                    <div class="d-flex flex-column gap-3">
                        <% if (exam.questions && exam.questions.length) { %>
                            <% exam.questions.forEach(function(q, idx){ %>
                                <div class="card shadow-sm border border-light p-3 bg-white">
                                    <input type="hidden" name="existingQuestions[<%= idx %>][id]" value="<%= q._id %>">
                                    
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                        <span class="fw-bold text-dark" style="font-size:0.875rem;">Question <%= idx + 1 %></span>
                                        <span class="badge bg-primary-subtle text-primary fw-semibold text-uppercase"><%= q.type %></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Question Text</label>
                                        <input type="text" class="form-control bg-light" name="existingQuestions[<%= idx %>][text]" value="<%- q.question %>" required>
                                    </div>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label text-muted small fw-bold text-uppercase">Question Type</label>
                                            <select class="form-select bg-light" name="existingQuestions[<%= idx %>][type]" onchange="toggleExistingOptions(this)" data-qid="ex-<%= idx %>">
                                                <option value="mcq" <%= q.type==='mcq'?'selected':'' %>>Multiple Choice (MCQ)</option>
                                                <option value="open" <%= q.type==='open'?'selected':'' %>>Open-ended</option>
                                                <option value="image" <%= q.type==='image'?'selected':'' %>>Image Question</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label text-muted small fw-bold text-uppercase">Points</label>
                                            <input type="number" class="form-control bg-light" name="existingQuestions[<%= idx %>][points]" value="<%= q.points || 1 %>" min="1">
                                        </div>
                                    </div>

                                    <!-- Options (visible for MCQ) -->
                                    <div class="mb-3 question-options" id="options-ex-<%= idx %>" style="display:<%= q.type==='mcq'?'':'none' %>">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Multiple Choice Options</label>
                                        <div class="row g-2">
                                            <% [0,1,2,3].forEach(function(i){ %>
                                                <div class="col-md-6">
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-light border-end-0 text-muted fw-bold"><%= String.fromCharCode(65+i) %></span>
                                                        <input type="text" class="form-control border-start-0 bg-light" name="existingQuestions[<%= idx %>][options][<%= i %>]" value="<%- (q.options && q.options[i]) ? q.options[i] : '' %>">
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>

                                    <!-- Upload box (visible for Image) -->
                                    <div class="mb-3 question-image" id="image-ex-<%= idx %>" style="display:<%= q.type==='image'?'':'none' %>">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Reference Image Upload</label>
                                        <input type="file" accept="image/*" class="form-control bg-light" data-qid="ex-<%= idx %>" onchange="encodeExistingImage(this)">
                                        <input type="hidden" name="existingQuestions[<%= idx %>][imageBase64]" id="img64-ex-<%= idx %>">
                                        <div class="mt-2">
                                            <img id="preview-ex-<%= idx %>" src="<%= q.imagePath || '' %>" alt="Preview" style="max-width: 100%; <%= q.imagePath ? '' : 'display:none;' %>" class="img-fluid rounded border shadow-sm">
                                        </div>
                                    </div>

                                    <!-- Accepted Answers (visible for Open/Image) -->
                                    <div class="mb-3 question-answers" id="answers-ex-<%= idx %>" style="display:<%= (q.type==='open' || q.type==='image')?'':'none' %>">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Fuzzy Grade Keywords (Comma-separated)</label>
                                        <input type="text" class="form-control bg-light" name="existingQuestions[<%= idx %>][acceptedAnswers]" value="<%- (q.acceptedAnswers && q.acceptedAnswers.join(', ')) || '' %>" placeholder="e.g. mitosis, photo synthesis">
                                    </div>

                                    <div class="mb-2" id="correct-wrapper-ex-<%= idx %>" style="display:<%= q.type==='mcq'?'':'none' %>">
                                        <label class="form-label text-muted small fw-bold text-uppercase">Correct Option</label>
                                        <select class="form-select bg-light" name="existingQuestions[<%= idx %>][correctAnswer]" id="correct-ex-<%= idx %>">
                                            <option value="">-- Choose correct MCQ option --</option>
                                            <option value="0" <%= q.correctAnswer === 0 ? 'selected' : '' %>>A</option>
                                            <option value="1" <%= q.correctAnswer === 1 ? 'selected' : '' %>>B</option>
                                            <option value="2" <%= q.correctAnswer === 2 ? 'selected' : '' %>>C</option>
                                            <option value="3" <%= q.correctAnswer === 3 ? 'selected' : '' %>>D</option>
                                        </select>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="alert bg-primary-subtle text-primary mb-0"><i class="bi bi-info-circle-fill me-1"></i> This exam has no questions yet.</div>
                        <% } %>
                    </div>
                </div>

                <!-- ADD MORE QUESTIONS -->
                <div class="card p-4 border-0 shadow-sm bg-white">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-task text-primary me-2"></i>Append More Questions</h5>
                        <button type="button" class="btn btn-success btn-sm px-3 rounded-pill" onclick="addQuestion()">
                            <i class="bi bi-plus-lg me-1"></i> Add Question
                        </button>
                    </div>

                    <div id="questionsContainer" class="d-flex flex-column gap-3">
                        <!-- New questions injected dynamically -->
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: CONTROLS -->
            <div class="col-lg-4">
                <div class="sticky-top sidebar-sticky-panel" style="top: calc(var(--topbar-height) + 1.5rem); z-index:1000;">
                    <div class="card p-4 border-0 shadow-sm bg-white">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-book text-primary me-2"></i>Instructions</h5>
                        <p class="text-muted small mb-4">Editing questions will update them instantly. Adding more questions will append them at the end of the assessment list.</p>
                        <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i> Save All Changes
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
let questionCount = 0;

function buildMcqOptionsHtml(idx) {
    return [0, 1, 2, 3].map(i => `
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted fw-bold">${String.fromCharCode(65 + i)}</span>
                <input type="text" class="form-control border-start-0 bg-light" name="questions[${idx}][options][${i}]" placeholder="Option text">
            </div>
        </div>
    `).join('');
}

function addQuestion() {
    questionCount++;
    const idx = questionCount - 1;
    const questionHtml = `
        <div class="card shadow-sm border border-light p-3 position-relative bg-white" id="question-${questionCount}">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <span class="fw-bold text-dark" style="font-size:0.875rem;">New Question ${questionCount}</span>
                <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removeQuestion(${questionCount})">
                    <i class="bi bi-trash-fill fs-5"></i>
                </button>
            </div>
            
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Question Prompt</label>
                <input type="text" class="form-control bg-light" name="questions[${idx}][text]" placeholder="Enter question..." required>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Question Type</label>
                    <select class="form-select bg-light" name="questions[${idx}][type]" onchange="toggleOptions(this)" data-qid="${idx}">
                        <option value="mcq">Multiple Choice (MCQ)</option>
                        <option value="open">Open-ended</option>
                        <option value="image">Image Question</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold text-uppercase">Points</label>
                    <input type="number" class="form-control bg-light" name="questions[${idx}][points]" value="1" min="1">
                </div>
            </div>

            <div class="mb-3 question-options" id="options-${idx}">
                <label class="form-label text-muted small fw-bold text-uppercase">Multiple Choice Options</label>
                <div class="row g-2">
                    ${buildMcqOptionsHtml(idx)}
                </div>
            </div>

            <div class="mb-3 question-image" id="image-${idx}" style="display:none;">
                <label class="form-label text-muted small fw-bold text-uppercase">Reference Image Upload</label>
                <input type="file" accept="image/*" class="form-control bg-light" name="questionImages">
            </div>

            <div class="mb-3 question-answers" id="answers-${idx}" style="display:none;">
                <label class="form-label text-muted small fw-bold text-uppercase">Fuzzy Grade Keywords (Comma-separated)</label>
                <input type="text" class="form-control bg-light" name="questions[${idx}][acceptedAnswers]" placeholder="e.g. mitosis, photo synthesis">
            </div>

            <div class="mb-2" id="correct-wrapper-${idx}">
                <label class="form-label text-muted small fw-bold text-uppercase">Correct Option</label>
                <select class="form-select bg-light" name="questions[${idx}][correctAnswer]" id="correct-${idx}">
                    <option value="">-- Choose correct MCQ option --</option>
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </div>
        </div>
    `;
    document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', questionHtml);
    const sel = document.querySelector(`select[name="questions[${idx}][type]"]`);
    if (sel) toggleOptions(sel);
}

function removeQuestion(id) {
    if (confirm('Are you sure you want to remove this question?')) {
        document.getElementById(`question-${id}`).remove();
    }
}

function toggleOptions(selectEl) {
    const qid = selectEl.dataset.qid;
    const val = selectEl.value;
    const optionsDiv = document.getElementById(`options-${qid}`);
    const correctSel = document.getElementById(`correct-${qid}`);
    const correctWrap = document.getElementById(`correct-wrapper-${qid}`);
    const imageDiv = document.getElementById(`image-${qid}`);
    const ansDiv = document.getElementById(`answers-${qid}`);
    
    if (val === 'open') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = false; i.value = ''; });
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = '';
    } else if (val === 'mcq') {
        if (optionsDiv) optionsDiv.style.display = '';
        if (correctSel) { correctSel.disabled = false; correctSel.required = true; }
        if (correctWrap) correctWrap.style.display = '';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = true; });
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = 'none';
    } else if (val === 'image') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; correctSel.value = ''; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (optionsDiv) optionsDiv.querySelectorAll('input').forEach(i => { i.required = false; i.value = ''; });
        if (imageDiv) imageDiv.style.display = '';
        if (ansDiv) ansDiv.style.display = '';
    }
}

function toggleExistingOptions(selectEl) {
    const qid = selectEl.dataset.qid;
    const val = selectEl.value;
    const optionsDiv = document.getElementById(`options-${qid}`);
    const correctSel = document.getElementById(`correct-${qid}`);
    const correctWrap = document.getElementById(`correct-wrapper-${qid}`);
    const imageDiv = document.getElementById(`image-${qid}`);
    const ansDiv = document.getElementById(`answers-${qid}`);
    if (val === 'open') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = '';
    } else if (val === 'mcq') {
        if (optionsDiv) optionsDiv.style.display = '';
        if (correctSel) { correctSel.disabled = false; correctSel.required = true; }
        if (correctWrap) correctWrap.style.display = '';
        if (imageDiv) imageDiv.style.display = 'none';
        if (ansDiv) ansDiv.style.display = 'none';
    } else if (val === 'image') {
        if (optionsDiv) optionsDiv.style.display = 'none';
        if (correctSel) { correctSel.disabled = true; correctSel.required = false; correctSel.value = ''; }
        if (correctWrap) correctWrap.style.display = 'none';
        if (imageDiv) imageDiv.style.display = '';
        if (ansDiv) ansDiv.style.display = '';
    }
}

function encodeExistingImage(inputEl) {
    const file = inputEl.files && inputEl.files[0];
    const qid = inputEl.getAttribute('data-qid');
    if (!file || !qid) return;
    const reader = new FileReader();
    reader.onload = function(e){
        const dataUrl = e.target.result;
        const hidden = document.getElementById(`img64-${qid}`);
        const prev = document.getElementById(`preview-${qid}`);
        if (hidden) hidden.value = dataUrl;
        if (prev) { prev.src = dataUrl; prev.style.display = ''; }
    };
    reader.readAsDataURL(file);
}
</script>

<%- include('../partials/footer') %>

<!-- Floating Action Button -->
<button type="button" class="fab-add-question" onclick="addQuestion()" title="Add Question">
    <i class="bi bi-plus-lg"></i>
</button>
