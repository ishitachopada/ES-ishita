    <% 
      const currentTitle = typeof title !== 'undefined' ? title : 'Home';
      const isExamPage = currentTitle.toLowerCase().includes('taking exam');
    %>
    <% if (typeof user !== 'undefined' && user !== null && !isExamPage) { %>
                </div><!-- .admin-content-inner -->
            </main><!-- .admin-content -->
        </div><!-- .admin-shell -->
    <% } else if (typeof user !== 'undefined' && user !== null && isExamPage) { %>
        <!-- No closing shell divs needed for exam focus screen -->
    <% } else { %>
        </main><!-- .page-main -->
    <% } %>

    <!-- STICKY FOOTER -->
    <% 
      const isAuthPage = typeof title !== 'undefined' && ['login', 'register', 'forgot', 'reset', 'verify otp', 'verify-otp', 'session ended', 'sessionended', 'error'].some(x => title.toLowerCase().includes(x));
    %>
    <% if (!isAuthPage) { %>
    <footer class="portal-footer border-top py-3 bg-white mt-auto w-100" style="font-size: 0.825rem; border-color: var(--border-color) !important;">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="text-muted fw-medium">&copy; 2026 ExamSystem. All rights reserved.</span>
        </div>
    </footer>
    <% } %>

    <!-- Bootstrap & JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js?v=1.0.4"></script>
</body>
</html>