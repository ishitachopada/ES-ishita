<%- include('../partials/header', { title: 'My Results' }) %>

<div class="row g-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2 border-bottom pb-3">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="bi bi-award text-primary me-2"></i>My Results History</h2>
                <p class="text-muted small mb-0">Track your scoring history, progress trends, and view detailed answer feedback sheets.</p>
            </div>
            <a href="/exams#dashboard" class="btn btn-outline-primary btn-sm"><i class="bi bi-grid-fill me-1"></i> Dashboard</a>
        </div>
    </div>

    <div class="col-12">
        <% if (!submissions || submissions.length === 0) { %>
            <div class="card p-5 text-center bg-white border-0 shadow-sm">
                <i class="bi bi-info-circle text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold text-dark">No Results Found</h5>
                <p class="text-muted small">You have not submitted any exam assessments yet.</p>
                <a href="/exams#my-exams" class="btn btn-primary btn-sm mt-2">View Available Exams</a>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm bg-white">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold text-dark">Completed Assessments</h5>
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-filter text-muted"></i></span>
                        <input type="text" id="resultTableSearch" class="form-control border-start-0" placeholder="Filter by title...">
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="table-light">
                                <th class="py-3 px-4">Assessment</th>
                                <th class="py-3">Success Curve</th>
                                <th class="py-3">Raw Score</th>
                                <th class="py-3">Submission Date</th>
                                <th class="py-3 px-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="resultTableBody">
                            <% submissions.forEach(s => { %>
                                <!-- tr carries 'card' class for client-side parser compatibility -->
                                <tr class="card" style="display: table-row; border: none; box-shadow: none; background: transparent;">
                                    <td class="px-4">
                                        <div class="fw-bold text-dark card-title mb-1"><%= s.exam ? s.exam.title : 'Assessment' %></div>
                                        <span class="text-muted small d-block" style="font-size: 0.775rem;"><%= s.exam && s.exam.description ? s.exam.description : 'Assessment attempt' %></span>
                                    </td>
                                    <td>
                                        <% const pct = s.totalQuestions > 0 ? Math.round((s.score / s.totalQuestions) * 100) : 0; %>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="max-width: 100px; height: 6px; background-color: var(--border-color);">
                                                <div class="progress-bar bg-success" style="width: <%= pct %>%;"></div>
                                            </div>
                                            <span class="fw-bold text-success" style="font-size:0.875rem;"><%= pct %>%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary fw-bold p-2">Score: <%= s.score %> / <%= s.totalQuestions %></span>
                                    </td>
                                    <td class="text-muted small">
                                        <%= new Date(s.submittedAt).toLocaleDateString([], {day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'}) %>
                                    </td>
                                    <td class="px-4 text-end">
                                        <a href="/exams/results/<%= s._id %>" class="btn btn-sm btn-outline-primary px-3 rounded-pill mb-1 d-inline-block">
                                            <i class="bi bi-eye-fill me-1"></i> View Report
                                        </a>
                                        <% const passingThreshold = (s.exam && s.exam.passingPercentage) ? s.exam.passingPercentage : 60; %>
                                        <% if (pct >= passingThreshold) { %>
                                            <a href="/exams/certificate/<%= s._id %>" class="btn btn-sm btn-outline-success px-3 rounded-pill mb-1 d-inline-block" target="_blank">
                                                <i class="bi bi-award me-1"></i> View Certificate
                                            </a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const search = document.getElementById('resultTableSearch');
    const rows = document.querySelectorAll('#resultTableBody tr');
    if (search) {
        search.addEventListener('input', function() {
            const query = search.value.toLowerCase();
            rows.forEach(row => {
                const text = row.querySelector('.card-title')?.textContent.toLowerCase() || '';
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }
});
</script>

<%- include('../partials/footer') %>
