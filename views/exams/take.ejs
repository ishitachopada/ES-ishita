<%- include('../partials/header', { title: 'Taking Exam: ' + exam.title }) %>

<div class="exam-focus-layout">
    <!-- LEFT: QUESTION PALETTE -->
    <aside class="exam-sidebar-panel exam-palette-panel">
        <div class="exam-panel-head">
            <div class="exam-panel-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            <div>
                <h2 class="exam-panel-title">Question Palette</h2>
                <p class="exam-panel-sub">Jump to any question</p>
            </div>
        </div>

        <div class="palette-grid" id="paletteGrid">
            <% for(let i = 0; i < exam.questions.length; i++) { %>
                <button type="button" class="palette-btn unvisited" id="paletteBtn_<%= i %>" data-question-index="<%= i %>"><%= i + 1 %></button>
            <% } %>
        </div>

        <div class="exam-palette-legend">
            <p class="exam-legend-title">Legend</p>
            <ul class="exam-legend-list">
                <li><span class="legend-dot legend-dot-current"></span> Current</li>
                <li><span class="legend-dot legend-dot-answered"></span> Answered</li>
                <li><span class="legend-dot legend-dot-marked"></span> Marked</li>
                <li><span class="legend-dot legend-dot-visited"></span> Visited</li>
            </ul>
        </div>
    </aside>

    <!-- CENTER: EXAM WORKSPACE -->
    <main class="exam-main-panel">
        <form id="examForm" action="/exams/submit/<%= exam._id %>" method="POST" class="exam-workspace-form d-flex flex-column h-100">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <header class="exam-header-card">
                <div class="exam-header-info">
                    <h1 class="exam-title"><%= exam.title %></h1>
                </div>
                <div class="exam-timer-badge" id="topTimerDisplay"><%= exam.duration %>:00</div>
            </header>

            <div class="exam-question-area flex-grow-1">
                <% exam.questions.forEach((question, index)=> { %>
                    <article class="question-card exam-question-card" data-index="<%= index %>" style="display: none;">
                        <div class="exam-question-meta">
                            <span class="exam-q-label">Question <%= index + 1 %> of <%= exam.questions.length %></span>
                            <span class="exam-q-points"><%= question.points %> pt<%= question.points !== 1 ? 's' : '' %></span>
                        </div>

                        <h2 class="exam-question-text"><%= question.question %></h2>

                        <% if (question.imagePath) { %>
                            <figure class="exam-question-figure">
                                <img src="<%= question.imagePath %>" alt="Question illustration" class="img-fluid">
                            </figure>
                        <% } %>

                        <% if (question.options && question.options.length > 0) { %>
                            <div class="option-container">
                                <% const oo=(typeof optionOrder !=='undefined' && Array.isArray(optionOrder)) ? optionOrder : []; 
                                   const order=oo[index] && Array.isArray(oo[index]) ? oo[index] : question.options.map((_, i)=> i); %>
                                <% order.forEach((optIdx, displayIdx) => { %>
                                    <div class="option-item" data-question-index="<%= index %>" data-option-index="<%= displayIdx %>">
                                        <span class="option-letter"><%= String.fromCharCode(65 + displayIdx) %></span>
                                        <input class="form-check-input" type="radio" name="answers[<%= index %>]" 
                                               id="q<%= index %>_<%= displayIdx %>" value="<%= displayIdx %>" required 
                                               >
                                        <label class="form-check-label" for="q<%= index %>_<%= displayIdx %>">
                                            <%= question.options[optIdx] %>
                                        </label>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="exam-text-answer">
                                <textarea class="form-control" name="answers[<%= index %>]" 
                                              placeholder="Type your answer here..." 
                                              data-textarea-question-index="<%= index %>"></textarea>
                            </div>
                        <% } %>
                    </article>
                <% }); %>
            </div>

            <footer class="exam-footer-controls">
                <div class="exam-controls-bar">
                    <div class="exam-nav-group">
                        <button type="button" class="btn btn-exam-nav" id="prevBtn">
                            <i class="bi bi-arrow-left"></i> Previous
                        </button>
                        <button type="button" class="btn btn-exam-nav" id="nextBtn">
                            Next <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                    <button type="button" class="btn btn-exam-mark" id="markReviewBtn">
                        <i class="bi bi-flag"></i> Mark for Review
                    </button>
                    <button type="button" class="btn btn-exam-submit" id="submitBtn">
                        <i class="bi bi-check-circle"></i> Submit Exam
                    </button>
                </div>
            </footer>
        </form>
    </main>

    <!-- RIGHT: TIMER, STATS & CALCULATOR -->
    <aside class="exam-sidebar-panel exam-tools-panel">
        <div class="exam-panel-head">
            <div class="exam-panel-icon exam-panel-icon-alt"><i class="bi bi-stopwatch"></i></div>
            <div>
                <h2 class="exam-panel-title">Timer &amp; Tools</h2>
                <p class="exam-panel-sub">Track progress &amp; calculate</p>
            </div>
        </div>

        <div class="exam-timer-card">
            <span class="exam-timer-label">Time Remaining</span>
            <div class="exam-timer-value" id="timer" data-duration="<%= exam.duration %>"><%= exam.duration %>:00</div>
        </div>

        <div class="exam-stats-card">
            <h3 class="exam-stats-title">Question Stats</h3>
            <dl class="exam-stats-list">
                <div class="exam-stat-row">
                    <dt>Total Questions</dt>
                    <dd><%= exam.questions.length %></dd>
                </div>
                <div class="exam-stat-row">
                    <dt>Total Weight</dt>
                    <dd><%= exam.questions.reduce((sum, q)=> sum + q.points, 0) %> pts</dd>
                </div>
                <div class="exam-stat-row">
                    <dt>Current</dt>
                    <dd id="activeSummaryLabel">Question 1</dd>
                </div>
            </dl>
        </div>

        <div class="calc-panel">
            <h3 class="calc-title"><i class="bi bi-calculator"></i> Calculator</h3>
            <input type="text" readonly id="calcDisplay" class="calc-display" placeholder="0">
            <div class="calc-grid">
                <button type="button" class="calc-key" data-calc="7">7</button>
                <button type="button" class="calc-key" data-calc="8">8</button>
                <button type="button" class="calc-key" data-calc="9">9</button>
                <button type="button" class="calc-key calc-key-op" data-calc="/">/</button>
                <button type="button" class="calc-key" data-calc="4">4</button>
                <button type="button" class="calc-key" data-calc="5">5</button>
                <button type="button" class="calc-key" data-calc="6">6</button>
                <button type="button" class="calc-key calc-key-op" data-calc="*">*</button>
                <button type="button" class="calc-key" data-calc="1">1</button>
                <button type="button" class="calc-key" data-calc="2">2</button>
                <button type="button" class="calc-key" data-calc="3">3</button>
                <button type="button" class="calc-key calc-key-op" data-calc="-">-</button>
                <button type="button" class="calc-key" data-calc="0">0</button>
                <button type="button" class="calc-key" data-calc=".">.</button>
                <button type="button" class="calc-key calc-key-clear" id="calcClearBtn">C</button>
                <button type="button" class="calc-key calc-key-op" data-calc="+">+</button>
                <button type="button" class="calc-key calc-key-equals" id="calcSolveBtn">=</button>
            </div>
        </div>
    </aside>
</div>

<script>
    // Anti-cheat: Invalidate if: tab loses focus/visibility
    const submissionId = '<%= submissionId %>';
    let invalidated = false;
    const pageId = Math.random().toString(36).slice(2);
    const channel = ('BroadcastChannel' in window) ? new BroadcastChannel('exam_guard_channel') : null;

    function invalidateAndLock() {
        if (invalidated) return;
        invalidated = true;
        try {
            if (navigator.sendBeacon) {
                const blob = new Blob([JSON.stringify({ ts: Date.now() })], { type: 'application/json' });
                navigator.sendBeacon('/exams/invalidate/' + submissionId + '?_csrf=<%= csrfToken %>', blob);
            } else {
                fetch('/exams/invalidate/' + submissionId + '?_csrf=<%= csrfToken %>', { method: 'POST' });
            }
        } catch (_) { }
        setTimeout(() => {
            document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#fff;"><h2 style=\"color:#EF4444;font-size:2rem;font-family:Poppins;\">Session Ended: Exam cannot be recovered.</h2></div>';
        }, 0);
    }
    
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) invalidateAndLock();
    });
    window.addEventListener('blur', function () { invalidateAndLock(); });

    if (channel) {
        channel.onmessage = function (e) {
            if (e && e.data && e.data.type === 'exam-open' && e.data.pageId !== pageId) {
                invalidateAndLock();
            }
        };
        setTimeout(() => channel.postMessage({ type: 'exam-open', pageId }), 50);
    }

    // Timer Countdown logic
    let timeLeft = (function () {
        const el = document.getElementById('timer');
        const raw = el ? parseInt(el.getAttribute('data-duration'), 10) : 0;
        const d = Number.isFinite(raw) ? raw : 0;
        return d * 60; // Seconds
    })();
    let isSubmitting = false;
    const timerElement = document.getElementById('timer');
    const topTimerElement = document.getElementById('topTimerDisplay');

    function updateTimer() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        const timeStr = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        
        if (timerElement) timerElement.textContent = timeStr;
        if (topTimerElement) topTimerElement.textContent = timeStr;

        if (timeLeft <= 300) { // Red under 5 mins
            if (timerElement) timerElement.classList.add('exam-timer-danger');
            if (topTimerElement) topTimerElement.classList.add('exam-timer-danger');
        }

        if (timeLeft <= 0) {
            clearInterval(timerInterval);
            document.getElementById('examForm').submit();
        }
        timeLeft--;
    }

    const timerInterval = setInterval(updateTimer, 1000);

    // Socket.io updates
    try {
        const socket = io();
        socket.emit('join-submission', submissionId);
        socket.on('submission:update', (payload) => {
            if (!payload) return;
            if (payload.status === 'invalidated') {
                invalidateAndLock();
            } else if (payload.status === 'submitted') {
                document.getElementById('examForm').submit();
            }
        });
    } catch (e) {}

    function submitExam() {
        const form = document.getElementById('examForm');
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        isSubmitting = true;
        
        sessionStorage.removeItem('maintainFullscreen');
        sessionStorage.removeItem('requestFullscreenOnLoad');
        sessionStorage.removeItem('fullscreenRequestTime');
        
        const formData = new FormData(form);
        const params = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
            params.append(key, value);
        }
        fetch(form.action, { 
            method: 'POST', 
            body: params, 
            headers: { 
                'x-requested-with': 'XMLHttpRequest', 
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 
                'Accept': 'application/json' 
            } 
        })
        .then(r => r.json())
        .then(data => {
            if (data && data.ok && data.resultUrl) {
                window.location.replace(data.resultUrl);
            } else {
                btn.disabled = false;
                isSubmitting = false;
            }
        })
        .catch(() => { btn.disabled = false; isSubmitting = false; });
    }

    const actualSubmitBtn = document.getElementById('submitBtn');
    if (actualSubmitBtn) {
        actualSubmitBtn.addEventListener('click', submitExam);
    }

    window.addEventListener('beforeunload', function (e) {
        if (!invalidated && !isSubmitting && timeLeft > 0) {
            invalidateAndLock();
            e.preventDefault();
            e.returnValue = '';
        }
    });

    // Sidebar Fullscreen Controls
    (function () {
        let fullscreenGuardActive = false;
        let reenterTimeout = null;
        let isRequestingFullscreen = false;
        
        function requestFullscreen(element) {
            if (isRequestingFullscreen) return Promise.resolve();
            if (!element) element = document.documentElement;
            
            isRequestingFullscreen = true;
            
            if (element.requestFullscreen) {
                return element.requestFullscreen().then(() => { isRequestingFullscreen = false; return true; }).catch(() => { isRequestingFullscreen = false; return false; });
            }
            if (element.webkitRequestFullscreen) {
                return element.webkitRequestFullscreen().then(() => { isRequestingFullscreen = false; return true; }).catch(() => { isRequestingFullscreen = false; return false; });
            }
            isRequestingFullscreen = false;
            return Promise.resolve(false);
        }

        function isFullscreen() {
            return !!(document.fullscreenElement || document.webkitFullscreenElement);
        }

        function setupFullscreenGuard() {
            if (fullscreenGuardActive) return;
            fullscreenGuardActive = true;
            
            const events = ['fullscreenchange', 'webkitfullscreenchange'];
            events.forEach(ev => {
                document.addEventListener(ev, function () {
                    const shouldMaintain = sessionStorage.getItem('maintainFullscreen') === 'true';
                    if (shouldMaintain && !isFullscreen() && !isRequestingFullscreen) {
                        if (reenterTimeout) clearTimeout(reenterTimeout);
                        reenterTimeout = setTimeout(() => {
                            if (!isFullscreen() && !isRequestingFullscreen) {
                                requestFullscreen();
                            }
                        }, 500);
                    }
                });
            });
        }

        function attemptFullscreen() {
            const shouldRequest = sessionStorage.getItem('requestFullscreenOnLoad') === 'true';
            const requestTime = parseInt(sessionStorage.getItem('fullscreenRequestTime') || '0', 10);
            const timeSinceRequest = Date.now() - requestTime;
            
            if (shouldRequest && timeSinceRequest < 5000 && !isFullscreen()) {
                sessionStorage.setItem('maintainFullscreen', 'true');
                sessionStorage.removeItem('requestFullscreenOnLoad');
                sessionStorage.removeItem('fullscreenRequestTime');
                setupFullscreenGuard();
                setTimeout(() => { requestFullscreen(); }, 200);
            } else if (!isFullscreen()) {
                attachToUserGesture();
            } else {
                sessionStorage.setItem('maintainFullscreen', 'true');
                setupFullscreenGuard();
            }
        }

        function attachToUserGesture() {
            let attached = false;
            const once = () => {
                if (attached) return;
                attached = true;
                requestFullscreen().then(success => {
                    if (success) {
                        sessionStorage.setItem('maintainFullscreen', 'true');
                        setupFullscreenGuard();
                    }
                    document.removeEventListener('click', once, true);
                });
            };
            document.addEventListener('click', once, true);
        }

        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            attemptFullscreen();
        } else {
            document.addEventListener('DOMContentLoaded', attemptFullscreen);
        }
    })();

    document.body.classList.add('exam-focus');

    // PAGINATION & PALETTE NAVIGATION
    const cards = Array.from(document.querySelectorAll('.question-card'));
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const markReviewBtn = document.getElementById('markReviewBtn');
    const submitBtn = document.getElementById('submitBtn');
    const activeLabel = document.getElementById('activeSummaryLabel');
    const progressBar = document.getElementById('examProgress');
    const paletteButtons = Array.from(document.querySelectorAll('[data-question-index]'));

    paletteButtons
        .filter(btn => btn.classList.contains('palette-btn'))
        .forEach(btn => {
            const qIndex = Number(btn.dataset.questionIndex);
            btn.addEventListener('click', () => navigateToQuestion(qIndex));
        });

    document.querySelectorAll('.option-item').forEach(item => {
        item.addEventListener('click', function () {
            const qIndex = Number(this.dataset.questionIndex);
            const oIndex = Number(this.dataset.optionIndex);
            selectRadioOption(qIndex, oIndex);
        });
    });

    document.querySelectorAll('[data-textarea-question-index]').forEach(textarea => {
        const qIndex = Number(textarea.dataset.textareaQuestionIndex);
        textarea.addEventListener('input', () => syncAnswerState(qIndex));
    });
    
    let currentIndex = 0;
    
    // Tracks status of each question
    const questionStates = Array.from({ length: cards.length }, () => ({
        visited: false,
        answered: false,
        marked: false
    }));

    // Set first question as visited initially
    questionStates[0].visited = true;

    function navigateToQuestion(idx) {
        if (idx >= 0 && idx < cards.length) {
            currentIndex = idx;
            questionStates[idx].visited = true;
            updateVisibility();
        }
    }

    function updateVisibility() {
        cards.forEach((el, idx) => {
            if (idx === currentIndex) {
                el.style.display = '';
                el.querySelectorAll('input[type="radio"]').forEach(i => i.required = true);
            } else {
                el.style.display = 'none';
                el.querySelectorAll('input[type="radio"]').forEach(i => i.required = false);
            }
        });
        
        // Update palette UI button states
        for (let i = 0; i < cards.length; i++) {
            const btn = document.getElementById(`paletteBtn_${i}`);
            if (!btn) continue;
            
            // Clear current states
            btn.className = 'palette-btn';
            
            const state = questionStates[i];
            if (i === currentIndex) {
                btn.classList.add('active');
            } else if (state.marked) {
                btn.classList.add('marked');
            } else if (state.answered) {
                btn.classList.add('answered');
            } else if (state.visited) {
                btn.classList.add('visited');
            } else {
                btn.classList.add('unvisited');
            }
        }
        
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === cards.length - 1;
        
        // Always display submitBtn but enable only at final questions if desired (keep standard style)
        submitBtn.style.display = currentIndex === cards.length - 1 ? '' : 'none';
        
        if (activeLabel) {
            activeLabel.textContent = `Question ${currentIndex + 1}`;
        }
        
        if (progressBar) {
            const pct = Math.max(0, Math.min(100, Math.round(((currentIndex + 1) / cards.length) * 100)));
            progressBar.style.width = pct + '%';
        }

        if (markReviewBtn) {
            const marked = questionStates[currentIndex].marked;
            markReviewBtn.classList.toggle('is-marked', marked);
            markReviewBtn.innerHTML = marked ?
                '<i class="bi bi-flag-fill"></i> Unmark Review' :
                '<i class="bi bi-flag"></i> Mark for Review';
        }
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    prevBtn.addEventListener('click', function () {
        if (currentIndex > 0) {
            currentIndex--;
            questionStates[currentIndex].visited = true;
            updateVisibility();
        }
    });

    nextBtn.addEventListener('click', function () {
        if (currentIndex < cards.length - 1) {
            currentIndex++;
            questionStates[currentIndex].visited = true;
            updateVisibility();
        }
    });

    // Mark for Review click handler
    if (markReviewBtn) {
        markReviewBtn.addEventListener('click', function() {
            questionStates[currentIndex].marked = !questionStates[currentIndex].marked;
            updateVisibility();
        });
    }

    // Radio Selection wrapper
    window.selectRadioOption = function(qIndex, oIndex) {
        const radio = document.getElementById(`q${qIndex}_${oIndex}`);
        if (radio) {
            radio.checked = true;
            const event = new Event('change', { bubbles: true });
            radio.dispatchEvent(event);
            syncAnswerState(qIndex);
        }
    }

    window.syncAnswerState = function(qIndex) {
        const card = cards[qIndex];
        let isAnswered = false;
        
        const checkedRadio = card.querySelector('input[type="radio"]:checked');
        if (checkedRadio) isAnswered = true;
        
        const textarea = card.querySelector('textarea');
        if (textarea && textarea.value.trim() !== '') isAnswered = true;
        
        questionStates[qIndex].answered = isAnswered;
        
        // update palette styles
        updateVisibility();
    }

    // Option highlight handler & initializer
    function initOptionHighlights() {
        document.querySelectorAll('.question-card input[type="radio"]').forEach(i => {
            const wrapper = i.closest('.option-item');
            if (wrapper) wrapper.classList.toggle('active', i.checked);
        });
    }

    document.querySelectorAll('.question-card input[type="radio"]').forEach(input => {
        input.addEventListener('change', function () {
            const group = this.name;
            document.querySelectorAll(`input[name="${group}"]`).forEach(i => {
                const wrapper = i.closest('.option-item');
                if (wrapper) wrapper.classList.toggle('active', i.checked);
            });
        });
    });

    // Initialize View
    updateVisibility();
    initOptionHighlights();

    // Calculator function binds
    let calcVal = '';
    const calcDisplay = document.getElementById('calcDisplay');
    
    function updateCalcDisplay() {
        if (calcDisplay) calcDisplay.value = calcVal;
    }

    document.querySelectorAll('[data-calc]').forEach(btn => {
        btn.addEventListener('click', function() {
            calcVal += this.getAttribute('data-calc');
            updateCalcDisplay();
        });
    });

    const clearBtn = document.getElementById('calcClearBtn');
    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            calcVal = '';
            if (calcDisplay) calcDisplay.value = '';
        });
    }
    
    function safeEvaluate(expr) {
        try {
            const tokens = expr.match(/(\d+\.?\d*|\+|\-|\*|\/)/g);
            if (!tokens) return '';
            
            for (let i = 0; i < tokens.length; i++) {
                if (tokens[i] === '*' || tokens[i] === '/') {
                    const a = parseFloat(tokens[i-1]);
                    const b = parseFloat(tokens[i+1]);
                    if (isNaN(a) || isNaN(b)) return 'Error';
                    let res = tokens[i] === '*' ? a * b : a / b;
                    tokens.splice(i-1, 3, res.toString());
                    i -= 2;
                }
            }
            for (let i = 0; i < tokens.length; i++) {
                if (tokens[i] === '+' || tokens[i] === '-') {
                    const a = parseFloat(tokens[i-1]);
                    const b = parseFloat(tokens[i+1]);
                    if (isNaN(a) || isNaN(b)) return 'Error';
                    let res = tokens[i] === '+' ? a + b : a - b;
                    tokens.splice(i-1, 3, res.toString());
                    i -= 2;
                }
            }
            return tokens.length === 1 ? Number(parseFloat(tokens[0]).toFixed(6)) : 'Error';
        } catch (e) {
            return 'Error';
        }
    }

    const solveBtn = document.getElementById('calcSolveBtn');
    if (solveBtn) {
        solveBtn.addEventListener('click', function() {
            try {
                if (!calcVal) return;
                const res = safeEvaluate(calcVal);
                if (calcDisplay) calcDisplay.value = res;
                calcVal = res === 'Error' ? '' : String(res);
            } catch(e) {
                if (calcDisplay) calcDisplay.value = 'Error';
                calcVal = '';
            }
        });
    }
</script>

<%- include('../partials/footer') %>
