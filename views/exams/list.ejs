    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Dynamic Search Filter for Dashboard Exams
    const searchInput = document.getElementById('examSearchInput');
    const cards = document.querySelectorAll('.exam-card-wrapper');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = searchInput.value.toLowerCase();
            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }

    // Dynamic Search Filter for My Exams tab
    const myExamsSearch = document.getElementById('myExamsSearch');
    const myExamWrappers = document.querySelectorAll('.my-exam-wrapper');
    if (myExamsSearch) {
        myExamsSearch.addEventListener('input', function() {
            const query = myExamsSearch.value.toLowerCase();
            myExamWrappers.forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }

    // Fullscreen parameters config for exam room launches
    document.querySelectorAll('.start-exam-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const examUrl = this.getAttribute('href');
            sessionStorage.setItem('requestFullscreenOnLoad', 'true');
            sessionStorage.setItem('fullscreenRequestTime', Date.now().toString());
            window.location.href = examUrl;
        });
    });

    // Real-time socket resets
    try {
        if (window.__appSocket) {
            window.__appSocket.on('submission:reset', function(payload){
                if (!payload || !payload.examId) return;
                window.location.href = '/exams/take/' + payload.examId;
            });
        }
    } catch (e) {}

    // Next Exam Countdown Timer simulation
    const countdownEl = document.getElementById('nextExamCountdown');
    if (countdownEl) {
        let diff = 3 * 3600 + 15 * 60; // 3h 15m mock countdown
        function updateCountdown() {
            const hours = Math.floor(diff / 3600);
            const minutes = Math.floor((diff % 3600) / 60);
            const seconds = diff % 60;
            countdownEl.textContent = `Starts in ${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m`;
            if (diff > 0) diff--;
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();
    }

    // RESULTS METRICS COMPILER
    fetch('/exams/my-results')
        .then(response => response.text())
        .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const resultCards = doc.querySelectorAll('#resultTableBody tr.card');

            let totalCompleted = resultCards.length;
            let sumPercentages = 0;
            let maxPercentage = 0;
            let countPassed = 0;
            let countFailed = 0;
            let countCertificates = 0;
            
            let chartLabels = [];
            let chartData = [];
            let subjectScores = {};
            let latestResultsHtml = '';
            let certificatesHtml = '';

            resultCards.forEach((card, idx) => {
                const titleEl = card.querySelector('.card-title');
                const title = titleEl ? titleEl.textContent.trim() : 'Exam';
                const badgeEl = card.querySelector('.badge');
                const badge = badgeEl ? badgeEl.textContent.trim() : '';
                const textEl = card.querySelector('.text-muted');
                const subject = textEl ? textEl.textContent.replace(/Subject:/i, '').trim() : 'General';
                
                // Parse score: e.g. "Score: 8 / 10"
                const scoreMatch = badge.match(/Score:\s*([\d\.]+)\s*\/\s*([\d\.]+)/);
                if (scoreMatch) {
                    const score = parseFloat(scoreMatch[1]);
                    const total = parseFloat(scoreMatch[2]);
                    const percentage = total > 0 ? Math.round((score / total) * 100) : 0;
                    
                    sumPercentages += percentage;
                    if (percentage > maxPercentage) maxPercentage = percentage;
                    
                    // Pass/fail counters (Pass threshold: >= 50%)
                    if (percentage >= 50) countPassed++;
                    else countFailed++;
                    
                    // Certificates (Threshold: >= 80%)
                    if (percentage >= 80) countCertificates++;

                    // Subject grouping
                    if (!subjectScores[subject]) {
                        subjectScores[subject] = { sum: 0, count: 0 };
                    }
                    subjectScores[subject].sum += percentage;
                    subjectScores[subject].count += 1;

                    // Timeline score logs
                    chartLabels.unshift(title.replace('Score:', '').substring(0, 12));
                    chartData.unshift(percentage);

                    // Add last 3 results to html list
                    if (idx < 3) {
                        latestResultsHtml += `
                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light">
                                <div class="text-truncate" style="max-width:180px;">
                                    <span class="fw-semibold text-dark d-block small">${title}</span>
                                    <span class="text-muted small" style="font-size:0.75rem;">${subject}</span>
                                </div>
                                <span class="badge ${percentage >= 70 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning'}">${percentage}%</span>
                            </div>
                        `;
                    }

                    // Certificate generation (>= 80%)
                    if (percentage >= 80) {
                        const viewReportBtn = card.querySelector('a[href^="/exams/results/"]');
                        let submissionId = '';
                        if (viewReportBtn) {
                            submissionId = viewReportBtn.getAttribute('href').split('/').pop();
                        }
                        const certId = 'CERT-' + Math.random().toString(36).substring(2, 10).toUpperCase();
                        certificatesHtml += `
                            <div class="col-12 col-md-4 col-lg-4">
                                <div class="card border-0 shadow-sm bg-white overflow-hidden hover-shadow transition-smooth rounded-3">
                                    <div class="position-relative" style="width: 100%; padding-top: 70.7%; overflow: hidden; background: #0b0f19; border-bottom: 1px solid #eee;">
                                        <iframe src="/exams/certificate/${submissionId}?preview=true" frameborder="0" scrolling="no" class="cert-iframe" style="position: absolute; top: 0; left: 0; width: 1100px; height: 778px; transform-origin: top left; pointer-events: none;"></iframe>
                                    </div>
                                    <div class="p-3 d-flex justify-content-between align-items-center bg-white">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 200px;">${title}</h6>
                                            <span class="text-muted small">Score: ${percentage}% &bull; ${new Date().toLocaleDateString()}</span>
                                        </div>
                                        <a href="/exams/certificate/${submissionId}" target="_blank" class="btn btn-primary btn-sm px-3 rounded-pill">
                                            <i class="bi bi-award me-1"></i> View / Print
                                        </a>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                }
            });

            // Update UI Counters
            const avgPercentage = totalCompleted > 0 ? Math.round(sumPercentages / totalCompleted) : 0;
            
            const statsCompleted = document.getElementById('statsCompleted');
            if (statsCompleted) statsCompleted.textContent = totalCompleted;
            
            const statsAverage = document.getElementById('statsAverage');
            if (statsAverage) statsAverage.textContent = avgPercentage + '%';
            
            const statsPending = document.getElementById('statsPending');
            const totalUpcoming = parseInt(document.getElementById('statsUpcoming')?.textContent || '0', 10);
            if (statsPending) statsPending.textContent = totalUpcoming;

            const statsCertificates = document.getElementById('statsCertificates');
            if (statsCertificates) statsCertificates.textContent = countCertificates;

            let rank = 'Pending';
            if (totalCompleted > 0) {
                if (avgPercentage >= 90) rank = 'Top 2%';
                else if (avgPercentage >= 80) rank = 'Top 7%';
                else if (avgPercentage >= 70) rank = 'Top 15%';
                else rank = 'Top 35%';
            }
            const statsRank = document.getElementById('statsRank');
            if (statsRank) statsRank.textContent = rank;

            // Injects results rows
            const resultsList = document.getElementById('latestResultsList');
            if (resultsList) {
                resultsList.innerHTML = latestResultsHtml || '<div class="text-center py-3 text-muted small">No assessments completed.</div>';
            }

            // Injects full performance table
            const perfTable = document.getElementById('performanceFullTableBody');
            if (perfTable) {
                const sourceBody = doc.getElementById('resultTableBody');
                if (sourceBody && sourceBody.innerHTML.trim() !== '') {
                    perfTable.innerHTML = sourceBody.innerHTML;
                } else {
                    perfTable.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-5">No assessments completed yet.</td></tr>';
                }
            }

            // Injects certificates list
            const certGrid = document.getElementById('certificatesGrid');
            if (certGrid) {
                certGrid.innerHTML = certificatesHtml || `
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-patch-exclamation fs-1 d-block mb-2 text-muted"></i>
                        No certificates earned yet. Achieve an 80% score or higher on any exam to receive a certificate.
                    </div>
                `;
                
                // Scale iframes to fit container
                function resizeCertIframes() {
                    document.querySelectorAll('.cert-iframe').forEach(iframe => {
                        if (iframe.parentElement) {
                            const scale = iframe.parentElement.clientWidth / 1100;
                            iframe.style.transform = 'scale(' + scale + ')';
                        }
                    });
                }
                setTimeout(resizeCertIframes, 50);
                window.addEventListener('resize', resizeCertIframes);
            }

            // Strong and Weak topics extraction
            let strongTopics = [];
            let weakTopics = [];
            Object.keys(subjectScores).forEach(sub => {
                const avg = Math.round(subjectScores[sub].sum / subjectScores[sub].count);
                if (avg >= 75) strongTopics.push(sub);
                else weakTopics.push(sub);
            });
            const strongEl = document.getElementById('strongTopicsList');
            if (strongEl) {
                strongEl.innerHTML = strongTopics.map(t => `<span class="badge bg-success-subtle text-success p-2 rounded-pill small me-1 mb-1"><i class="bi bi-arrow-up-circle-fill me-1"></i> ${t}</span>`).join('') || '<span class="text-muted small">No topics assessed yet.</span>';
            }
            const weakEl = document.getElementById('weakTopicsList');
            if (weakEl) {
                weakEl.innerHTML = weakTopics.map(t => `<span class="badge bg-danger-subtle text-danger p-2 rounded-pill small me-1 mb-1"><i class="bi bi-arrow-down-circle-fill me-1"></i> ${t}</span>`).join('') || '<span class="text-muted small">No weak areas identified.</span>';
            }

            // Sync user profile values
            const profileAvgLabel = document.getElementById('profileAvgLabel');
            if (profileAvgLabel) profileAvgLabel.textContent = avgPercentage + '%';
            const profileCountLabel = document.getElementById('profileCountLabel');
            if (profileCountLabel) profileCountLabel.textContent = totalCompleted;

            // Leaderboard user scores sync
            const userScoreBadge = document.getElementById('leaderboardUserScore');
            if (userScoreBadge) userScoreBadge.textContent = avgPercentage + '%';
            const userRankBadge = document.getElementById('leaderboardUserRank');
            if (userRankBadge && rank !== 'Pending') {
                userRankBadge.textContent = rank.includes('2%') ? '1' : rank.includes('7%') ? '2' : '3';
            }

            // Recent activity timeline update
            const activityList = document.getElementById('recentActivityList');
            if (activityList && totalCompleted > 0) {
                activityList.innerHTML += `
                    <div class="timeline-item mt-2">
                        <span class="text-dark fw-semibold">Assessment Checked</span>
                        <p class="text-muted mb-0 small">Average grade evaluated at ${avgPercentage}%.</p>
                    </div>
                `;
            }

            // Fallback mock setups if no exam history available
            if (totalCompleted === 0) {
                chartLabels = ['Quiz Alpha', 'Quiz Beta', 'Mid-Term'];
                chartData = [65, 82, 78];
                subjectScores = { 'Science': { sum: 75, count: 1 }, 'Languages': { sum: 85, count: 1 }, 'Technology': { sum: 80, count: 1 } };
                countPassed = 2;
                countFailed = 1;
            }

            renderStudentCharts({ chartLabels, chartData, subjectScores, countPassed, countFailed });
        })
        .catch(err => {
            console.error('Metrics loading failed:', err);
            renderStudentCharts({
                chartLabels: ['Quiz Alpha', 'Quiz Beta', 'Mid-Term'],
                chartData: [65, 82, 78],
                subjectScores: {
                    'Science': { sum: 75, count: 1 },
                    'Languages': { sum: 85, count: 1 },
                    'Technology': { sum: 80, count: 1 }
                },
                countPassed: 2,
                countFailed: 1
            });
        });

    function renderStudentCharts(metrics) {
        if (typeof Chart === 'undefined') return;

        const chartLabels = metrics.chartLabels || [];
        const chartData = metrics.chartData || [];
        const subjectScores = metrics.subjectScores || {};
        const countPassed = metrics.countPassed || 0;
        const countFailed = metrics.countFailed || 0;

        const lineCanvas = document.getElementById('studentPerformanceChart');
        const barCanvas = document.getElementById('subjectMarksChart');
        const doughnutCanvas = document.getElementById('passFailChart');
        const tabLineCanvas = document.getElementById('performanceTabProgressionChart');

        if (lineCanvas) {
            new Chart(lineCanvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Score',
                        data: chartData,
                        borderColor: '#3B82F6',
                        backgroundColor: 'rgba(59, 130, 246, 0.08)',
                        borderWidth: 3,
                        pointBackgroundColor: '#3B82F6',
                        pointBorderColor: '#ffffff',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { min: 0, max: 100, ticks: { stepSize: 20 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        const subLabels = Object.keys(subjectScores);
        const subData = subLabels.map(s => Math.round(subjectScores[s].sum / subjectScores[s].count));

        if (barCanvas) {
            new Chart(barCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: subLabels.length ? subLabels : ['General'],
                    datasets: [{
                        data: subData.length ? subData : [0],
                        backgroundColor: '#1E3A8A',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { min: 0, max: 100 },
                        y: { grid: { display: false } }
                    }
                }
            });
        }

        if (doughnutCanvas) {
            new Chart(doughnutCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Passed', 'Failed'],
                    datasets: [{
                        data: [countPassed, countFailed],
                        backgroundColor: ['#10B981', '#EF4444'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10 } }
                    }
                }
            });
        }

        if (tabLineCanvas) {
            new Chart(tabLineCanvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Score',
                        data: chartData,
                        borderColor: '#10B981',
                        backgroundColor: 'rgba(16, 185, 129, 0.08)',
                        borderWidth: 3,
                        pointBackgroundColor: '#10B981',
                        pointBorderColor: '#ffffff',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { min: 0, max: 100, ticks: { stepSize: 20 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        setTimeout(() => window.dispatchEvent(new Event('resize')), 150);
    }
});

// Single Page Tab Hash Router
(function() {
    const studentTabs = [
        'dashboard', 'my-exams', 'upcoming-exams', 'live-exams', 
        'performance', 'certificates', 'notifications', 'calendar', 
        'profile', 'help', 'settings'
    ];
    
    function switchTab() {
        const hash = window.location.hash.substring(1) || 'dashboard';
        const activeTab = studentTabs.includes(hash) ? hash : 'dashboard';
        
        // Show active section, hide others
        studentTabs.forEach(tab => {
            const el = document.getElementById(`student-tab-${tab}`);
            if (el) {
                el.classList.toggle('d-none', tab !== activeTab);
            }
        });
        
        // Sync page title
        const tabNames = {
            'dashboard': 'Exams Dashboard',
            'my-exams': 'My Available Exams',
            'upcoming-exams': 'Upcoming Exam Schedules',
            'live-exams': 'Active Live Exams',
            'performance': 'My Academic Performance',
            'certificates': 'My Earned Certificates',
            'notifications': 'Notification Center',
            'calendar': 'Assessment Calendar',
            'profile': 'My Student Profile',
            'help': 'Help & Support Center',
            'settings': 'System Settings'
        };
        document.title = 'ExamSystem - ' + (tabNames[activeTab] || 'Student Portal');
        setTimeout(() => window.dispatchEvent(new Event('resize')), 100);
    }
    
    window.addEventListener('hashchange', switchTab);
    document.addEventListener('DOMContentLoaded', switchTab);
})();
</script>

