                                    <label class="form-label text-muted small">Academic Department</label>
                                    <input type="text" class="form-control" value="Computer Science Engineering" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Student Batch Year</label>
                                    <input type="text" class="form-control" value="Batch of 2026" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Authentication Status</label>
                                    <input type="text" class="form-control" value="MFA Active" readonly>
                                </div>
                                <div class="col-12 mt-4 pt-3 border-top d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary btn-sm px-4">Update Metadata</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- HELP TAB -->
        <div id="student-tab-help" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm bg-white">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-question-circle-fill text-primary me-2"></i>Help & Support Center</h4>
                <p class="text-muted small mb-4">Resolve proctoring issues, browser lockdown alerts, or grading queries.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark"><i class="bi bi-shield-check text-success me-2"></i>Lockdown / Tab Switch Alert FAQ</h6>
                        <p class="text-muted small">The portal enforces full-screen lockdown. Switching tabs, resizing windows, or opening devtools will trigger an automatic assessment invalidation. Please close all other background applications before starting.</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark"><i class="bi bi-envelope text-primary me-2"></i>Grading Sheets Inquiry</h6>
                        <p class="text-muted small">If your answer reviews are missing, the faculty may have disabled answer releases. Please message your proctor or coordinator to request score sheets release.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SETTINGS TAB -->
        <div id="student-tab-settings" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm bg-white">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-gear-fill text-primary me-2"></i>Portal Settings</h4>
                <p class="text-muted small mb-4">Adjust portal aesthetics and notification configurations.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Active Interface Theme</label>
                        <select class="form-select" onchange="document.getElementById('darkModeToggleBtn').click()">
                            <option value="light">Light Theme</option>
                            <option value="dark">Dark Theme</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Browser Language</label>
                        <select class="form-select">
                            <option value="en">English (US)</option>
                            <option value="es">Español</option>
                        </select>
                    </div>
                </div>
