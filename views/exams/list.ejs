<%- include('../partials/header', { title: 'Exams Dashboard' }) %>

<div class="row g-4">
    <!-- TABS CONTAINER BLOCK -->
    <div class="col-12">
        
        <!-- DASHBOARD TAB -->
        <div id="student-tab-dashboard" class="student-portal-tab-content">
            <div class="row g-4 mb-4">
                <!-- RECENT WELCOME & HERO BANNER -->
                <div class="col-12">
                    <div class="dashboard-hero p-4 text-white rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" style="min-height: auto; background: linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%);">
                        <div>
                            <span class="badge bg-light text-primary mb-2 fw-semibold px-2.5 py-1 text-uppercase" style="font-size:0.75rem;"><i class="bi bi-person-workspace me-1"></i> Student Workspace</span>
                            <h2 class="fw-bold mb-1 text-white">Welcome back, <%= user.username %>!</h2>
                            <p class="mb-0 text-white-50 small">Review your progress curves, track certificates, and take available assessments.</p>
                        </div>
                        
                        <!-- NEXT EXAM QUICK TIMER CARD -->
                        <% if (exams && exams.length > 0) { %>
                            <div class="bg-white bg-opacity-10 border border-white border-opacity-10 rounded p-3 text-start hero-side-card" style="backdrop-filter: blur(10px);">
                                <div class="small text-white-50 fw-semibold text-uppercase tracking-wider mb-1"><i class="bi bi-clock-history me-1"></i> Next Exam Target</div>
                                <div class="fw-bold text-white text-truncate" style="font-size: 0.95rem;"><%= exams[0].title %></div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge bg-primary text-white" style="font-size:0.75rem;"><%= exams[0].duration %> mins</span>
                                    <span class="text-white fw-bold small" id="nextExamCountdown" data-duration="<%= exams[0].duration %>">Active Now</span>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="bg-white bg-opacity-10 border border-white border-opacity-10 rounded p-3 text-center hero-side-card" style="backdrop-filter: blur(10px);">
                                <span class="text-white-50 small d-block"><i class="bi bi-shield-check me-1"></i> All Caught Up</span>
                                <span class="text-white fw-semibold small mt-1 d-block">No pending assessments</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- SIX MODERN STATS CARDS -->
                <div class="col-12">
                    <div class="stats-grid">
                        <div class="stat-card border-start border-4 border-primary">
                            <span class="stat-icon accent-primary"><i class="bi bi-hourglass-split"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Upcoming</span>
                                <div class="stat-value" id="statsUpcoming"><%= exams.length %></div>
                            </div>
                        </div>
                        <div class="stat-card border-start border-4 border-success">
                            <span class="stat-icon accent-success"><i class="bi bi-clipboard2-check"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Completed</span>
                                <div class="stat-value" id="statsCompleted">0</div>
                            </div>
                        </div>
                        <div class="stat-card border-start border-4 border-info">
                            <span class="stat-icon accent-info"><i class="bi bi-patch-check"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Avg Score</span>
                                <div class="stat-value" id="statsAverage">0%</div>
                            </div>
                        </div>
                        <div class="stat-card border-start border-4 border-warning">
                            <span class="stat-icon accent-warning"><i class="bi bi-trophy"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Class Rank</span>
                                <div class="stat-value" id="statsRank">Pending</div>
                            </div>
                        </div>
                        <div class="stat-card border-start border-4 border-danger">
                            <span class="stat-icon accent-danger"><i class="bi bi-file-earmark-lock"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Pending</span>
                                <div class="stat-value" id="statsPending"><%= exams.length %></div>
                            </div>
                        </div>
                        <div class="stat-card border-start border-4 border-secondary">
                            <span class="stat-icon accent-muted"><i class="bi bi-award"></i></span>
                            <div class="stat-info">
                                <span class="stat-title">Certificates</span>
                                <div class="stat-value" id="statsCertificates">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-main-grid">
                <!-- Left panel content -->
                <div class="d-flex flex-column gap-4">
                    <!-- CHARTS CONTAINER -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-activity text-primary me-2"></i>Performance Dashboard</h5>
                        <p class="text-muted small mb-3">Analyze progress trends, topic strengths, and success metrics.</p>
                        
                        <div class="row g-3">
                            <!-- Progress curve -->
                            <div class="col-12">
                                <div class="border rounded p-3 bg-light" style="overflow: hidden;">
                                    <span class="fw-bold text-dark small d-block mb-3"><i class="bi bi-graph-up me-1"></i>Score Progression Curve</span>
                                    <div class="chart-container chart-container-md">
                                        <canvas id="studentPerformanceChart"></canvas>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Subject-wise bar & Pass/fail distribution doughnut -->
                            <div class="col-12 col-md-6" style="min-width: 0;">
                                <div class="border rounded p-3 bg-light h-100" style="overflow: hidden;">
                                    <span class="fw-bold text-dark small d-block mb-3"><i class="bi bi-bar-chart-line me-1"></i>Marks by Subject Domain</span>
                                    <div class="chart-container chart-container-sm">
                                        <canvas id="subjectMarksChart"></canvas>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12 col-md-6" style="min-width: 0;">
                                <div class="border rounded p-3 bg-light h-100" style="overflow: hidden;">
                                    <span class="fw-bold text-dark small d-block mb-3"><i class="bi bi-pie-chart me-1"></i>Pass/Fail Distribution</span>
                                    <div class="chart-container chart-container-sm">
                                        <canvas id="passFailChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- AVAILABLE EXAMS LIST -->
                    <div class="card p-4 border-0 shadow-sm" id="availableExamsSection">
                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Active Assessment Library</h5>
                                <p class="text-muted small mb-0">Select an assessment to begin. Ensure a stable network connection.</p>
                            </div>
                            <div class="input-group search-input-group">
                                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="examSearchInput" class="form-control border-start-0" placeholder="Search by name...">
                            </div>
                        </div>

                        <div class="row g-3" id="examsContainer">
                            <% if (exams.length === 0) { %>
                                <div class="col-12 text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-2 d-block mb-2 text-muted"></i>
                                    No active exams available at this moment.
                                </div>
                            <% } else { %>
                                <% exams.forEach(exam => { %>
                                    <% const hasNegativeMarking = (exam._id.toString().charCodeAt(0) % 2 === 0);
                                       const diffHash = exam._id.toString().charCodeAt(1) % 3;
                                       const difficulty = diffHash === 0 ? 'Easy' : (diffHash === 1 ? 'Medium' : 'Hard');
                                       const diffColor = diffHash === 0 ? 'success' : (diffHash === 1 ? 'warning' : 'danger'); %>
                                    <div class="col-12 col-md-6 exam-card-wrapper">
                                        <div class="card border border-light h-100 hover-shadow transition-smooth">
                                            <div class="card-body p-4 d-flex flex-column">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge bg-light text-primary px-2.5 py-1 text-uppercase" style="font-size:0.7rem;"><%= exam.subject || 'General' %></span>
                                                    <span class="badge bg-<%= diffColor %>-subtle text-<%= diffColor %> text-uppercase fw-bold" style="font-size:0.65rem;"><%= difficulty %></span>
                                                </div>
                                                <h5 class="fw-bold text-dark mb-1"><%= exam.title %></h5>
                                                <p class="text-muted small mb-3 flex-grow-1" style="min-height: 38px;"><%= exam.description %></p>
                                                
                                                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center bg-light rounded p-2.5 mb-3 small text-muted">
                                                    <span><i class="bi bi-clock text-primary me-1"></i> <%= exam.duration %> Min</span>
                                                    <span><i class="bi bi-card-list text-primary me-1"></i> <%= exam.questions.length %> Qs</span>
                                                    <span><i class="bi bi-award text-primary me-1"></i> <%= exam.questions.length * 10 %> Pts</span>
                                                    <span class="badge <%= hasNegativeMarking ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> text-uppercase" style="font-size: 0.65rem;">
                                                        <%= hasNegativeMarking ? '-1/4 Neg' : 'No Neg' %>
                                                    </span>
                                                </div>
                                                
                                                <div class="small text-muted mb-3"><i class="bi bi-person-badge text-primary me-1"></i> Faculty: <%= exam.createdBy ? exam.createdBy.username : 'Academic Administrator' %></div>

                                                <% if (user && user.role === 'admin') { %>
                                                    <a href="/admin/manage-exams" class="btn btn-outline-secondary btn-sm w-100">
                                                        <i class="bi bi-shield-lock me-1"></i> Admin View
                                                    </a>
                                                <% } else { %>
                                                    <a href="/exams/take/<%= exam._id %>" class="btn btn-primary btn-sm w-100 start-exam-btn">
                                                        <i class="bi bi-play-circle me-1"></i> Start Assessment
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                </div>
                
                <!-- Right panel content -->
                <div class="d-flex flex-column gap-4">
                    <!-- COMPETITIVE LEADERBOARD WIDGET -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-trophy text-warning me-2"></i>Class Leaderboard</h6>
                        <div class="d-flex flex-column gap-2" id="leaderboardContainer">
                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark rounded-circle" style="width:22px; height:22px; display:inline-flex; align-items:center; justify-content:center;">1</span>
                                    <span class="small fw-semibold text-dark">Alex M.</span>
                                </div>
                                <span class="badge bg-secondary">96%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary text-white rounded-circle" style="width:22px; height:22px; display:inline-flex; align-items:center; justify-content:center;">2</span>
                                    <span class="small fw-semibold text-dark">Elena K.</span>
                                </div>
                                <span class="badge bg-secondary">91%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded border border-primary-subtle bg-primary bg-opacity-10" id="leaderboardUserRow">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary text-white rounded-circle" style="width:22px; height:22px; display:inline-flex; align-items:center; justify-content:center;" id="leaderboardUserRank">3</span>
                                    <span class="small fw-bold text-primary"><%= user.username %> (You)</span>
                                </div>
                                <span class="badge bg-primary" id="leaderboardUserScore">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- EXAM CALENDAR WIDGET -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-calendar-event text-primary me-2"></i>Assessment Calendar</h6>
                        <div class="p-2 bg-light rounded text-center mb-3">
                            <span class="fw-bold text-primary small" id="calendarMonth">July 2026</span>
                        </div>
                        <div class="d-flex flex-column gap-2 text-start" style="font-size: 0.8rem;">
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary rounded-circle" style="width:8px; height:8px; padding:0;">&nbsp;</span>
                                    <span>Today</span>
                                </div>
                                <span class="text-muted fw-bold">01 Jul</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning rounded-circle" style="width:8px; height:8px; padding:0;">&nbsp;</span>
                                    <span class="text-truncate" style="max-width:140px;"><%= exams.length > 0 ? exams[0].title : 'Pending Exams' %></span>
                                </div>
                                <span class="text-muted">05 Jul</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success rounded-circle" style="width:8px; height:8px; padding:0;">&nbsp;</span>
                                    <span>Term Final Assessment</span>
                                </div>
                                <span class="text-muted">18 Jul</span>
                            </div>
                        </div>
                    </div>

                    <!-- LATEST RESULTS LIST -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-award text-success me-2"></i>Latest Results</h6>
                        <div class="d-flex flex-column gap-2" id="latestResultsList">
                            <!-- Loaded dynamically via results scraper -->
                            <div class="text-center py-3 text-muted small">No results parsed yet.</div>
                        </div>
                    </div>

                    <!-- BULLETIN ANNOUNCEMENTS -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-megaphone text-info me-2"></i>Announcements</h6>
                        <div class="d-flex flex-column gap-2 text-start" style="font-size: 0.8rem;">
                            <% if (typeof allNotifications !== 'undefined' && allNotifications.length > 0) { %>
                                <% allNotifications.slice(0, 3).forEach(notif => { 
                                    let borderClass = 'border-primary';
                                    let textClass = 'text-primary';
                                    if (notif.category === 'exam') { borderClass = 'border-success'; textClass = 'text-success'; }
                                    else if (notif.category === 'urgent') { borderClass = 'border-danger'; textClass = 'text-danger'; }
                                    else if (notif.category === 'system') { borderClass = 'border-info'; textClass = 'text-info'; }
                                %>
                                <div class="p-2.5 rounded bg-light border-start border-3 <%= borderClass %>">
                                    <div class="fw-bold text-dark <%= textClass %>"><%= notif.title %></div>
                                    <p class="text-muted mb-0 small mt-0.5"><%= notif.body %></p>
                                </div>
                                <% }); %>
                            <% } else { %>
                                <div class="p-3 text-center text-muted border border-dashed rounded bg-light">
                                    No announcements yet.
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- TIMELINE ACTIVITY -->
                    <div class="card p-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Recent Activity</h6>
                        <div class="timeline" style="font-size:0.8rem;" id="recentActivityList">
                            <div class="timeline-item">
                                <span class="text-dark fw-semibold">Workspace Loaded</span>
                                <p class="text-muted mb-0 small">Dashboard session compiled.</p>
                                <span class="text-muted small" style="font-size:0.7rem;"><%= new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MY EXAMS TAB -->
        <div id="student-tab-my-exams" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 border-bottom pb-3">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-check text-primary me-2"></i>My Departmental Exams</h4>
                        <p class="text-muted small mb-0">Browse and launch active exams allocated to you.</p>
                    </div>
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Search exams..." id="myExamsSearch">
                    </div>
                </div>
                <div class="row g-3" id="myExamsGrid">
                    <!-- Dynamic rendering of exams cards -->
                    <% if (exams.length === 0) { %>
                        <div class="col-12 text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2 text-muted"></i> No available exams.
                        </div>
                    <% } else { %>
                        <% exams.forEach(exam => { %>
                            <% const hasNegativeMarking = (exam._id.toString().charCodeAt(0) % 2 === 0);
                               const diffHash = exam._id.toString().charCodeAt(1) % 3;
                               const difficulty = diffHash === 0 ? 'Easy' : (diffHash === 1 ? 'Medium' : 'Hard');
                               const diffColor = diffHash === 0 ? 'success' : (diffHash === 1 ? 'warning' : 'danger'); %>
                            <div class="col-12 col-md-6 col-lg-4 my-exam-wrapper">
                                <div class="card border border-light h-100 hover-shadow transition-smooth bg-white">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-light text-primary px-2.5 py-1 text-uppercase" style="font-size:0.7rem;"><%= exam.subject || 'General' %></span>
                                            <span class="badge bg-<%= diffColor %>-subtle text-<%= diffColor %> text-uppercase fw-bold" style="font-size:0.65rem;"><%= difficulty %></span>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1"><%= exam.title %></h5>
                                        <p class="text-muted small mb-3 flex-grow-1"><%= exam.description %></p>
                                        
                                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center bg-light rounded p-2 mb-3 small text-muted">
                                            <span><i class="bi bi-clock text-primary me-1"></i> <%= exam.duration %> Min</span>
                                            <span><i class="bi bi-card-list text-primary me-1"></i> <%= exam.questions.length %> Qs</span>
                                            <span class="badge <%= hasNegativeMarking ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> text-uppercase" style="font-size: 0.65rem;">
                                                <%= hasNegativeMarking ? '-1/4 Neg' : 'No Neg' %>
                                            </span>
                                        </div>
                                        <div class="small text-muted"><i class="bi bi-person-badge text-primary me-1"></i> Faculty: <%= exam.createdBy ? exam.createdBy.username : 'Administrator' %></div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- UPCOMING EXAMS TAB -->
        <div id="student-tab-upcoming-exams" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-hourglass-split text-primary me-2"></i>Upcoming Scheduled Quizzes</h4>
                <p class="text-muted small mb-4">View quizzes and mid-terms scheduled by the academic board.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="card p-3 border border-light bg-light">
                            <span class="badge bg-warning text-dark align-self-start mb-2 px-2.5 py-1 text-uppercase" style="font-size:0.7rem;">Scheduled</span>
                            <h5 class="fw-bold text-dark mb-1">Algorithms Mid-Term</h5>
                            <p class="text-muted small mb-3">Comprehensive analysis of graphs, heaps, and tree traversal algorithms.</p>
                            <div class="d-flex justify-content-between align-items-center text-muted small border-top pt-2">
                                <span><i class="bi bi-calendar-event me-1"></i> July 05, 2026</span>
                                <span><i class="bi bi-clock me-1"></i> 10:00 AM</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="card p-3 border border-light bg-light">
                            <span class="badge bg-warning text-dark align-self-start mb-2 px-2.5 py-1 text-uppercase" style="font-size:0.7rem;">Scheduled</span>
                            <h5 class="fw-bold text-dark mb-1">Database Systems Lab</h5>
                            <p class="text-muted small mb-3">Live evaluation of SQL indexing, query optimization, and normalization constraints.</p>
                            <div class="d-flex justify-content-between align-items-center text-muted small border-top pt-2">
                                <span><i class="bi bi-calendar-event me-1"></i> July 12, 2026</span>
                                <span><i class="bi bi-clock me-1"></i> 02:00 PM</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LIVE EXAMS TAB -->
        <div id="student-tab-live-exams" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm text-center">
                <div class="mb-3">
                    <span class="spinner-grow spinner-grow-sm text-danger me-2" role="status"></span>
                    <h4 class="fw-bold d-inline-block text-dark">Active Live Assessment Portal</h4>
                </div>
                <p class="text-muted small mb-4">Tests currently active for your department. Complete them before the access window closes.</p>
                <div class="row g-3 justify-content-center">
                    <% if (exams.length === 0) { %>
                        <div class="col-12 text-center py-5 text-muted bg-light rounded border border-dashed">
                            <i class="bi bi-shield-slash fs-2 d-block mb-2 text-muted"></i> No live tests currently active.
                        </div>
                    <% } else { %>
                        <% exams.forEach(exam => { %>
                            <div class="col-12 col-md-6 col-lg-5">
                                <div class="card border-danger border-2 h-100 shadow-sm bg-white p-4">
                                    <span class="badge bg-danger text-white align-self-center mb-3 px-3 py-1 text-uppercase fw-bold" style="font-size:0.75rem;"><i class="bi bi-broadcast me-1"></i> Live Assessment</span>
                                    <h5 class="fw-bold text-dark mb-2"><%= exam.title %></h5>
                                    <p class="text-muted small mb-3"><%= exam.description %></p>
                                    <div class="d-flex justify-content-center gap-3 mb-4 text-muted small">
                                        <span><i class="bi bi-clock text-primary"></i> <%= exam.duration %> Min</span>
                                        <span><i class="bi bi-card-list text-primary"></i> <%= exam.questions.length %> Qs</span>
                                    </div>
                                    <a href="/exams/take/<%= exam._id %>" class="btn btn-danger btn-sm w-100 py-2 fw-semibold start-exam-btn">
                                        <i class="bi bi-play-circle me-1"></i> Enter Exam Room
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- PERFORMANCE TAB -->
        <div id="student-tab-performance" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-activity text-primary me-2"></i>My Comprehensive Progress Metrics</h4>
                <p class="text-muted small mb-4">Deep analytics on your grades, subject domain strengths, and weak areas.</p>
                
                <div class="row g-4">
                    <!-- Chart progression curve -->
                    <div class="col-12 col-lg-8">
                        <div class="border rounded p-4 bg-light">
                            <span class="fw-bold text-dark small d-block mb-3"><i class="bi bi-graph-up me-1 text-primary"></i>Score Progression Curve (Historical Trend)</span>
                            <div class="chart-container chart-container-lg">
                                <canvas id="performanceTabProgressionChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Side card with recommendations -->
                    <div class="col-12 col-lg-4">
                        <div class="card border border-light bg-light p-4 h-100">
                            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-cpu text-primary me-2"></i>AI Study Recommendation</h5>
                            <hr class="mt-0">
                            
                            <div class="mb-3">
                                <span class="text-muted small d-block mb-2">Subject Strengths (>= 75% Average):</span>
                                <div id="strongTopicsList" class="d-flex flex-wrap gap-1">
                                    <!-- Dynamic loading -->
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small d-block mb-2">Review Recommended (< 75%):</span>
                                <div id="weakTopicsList" class="d-flex flex-wrap gap-1">
                                    <!-- Dynamic loading -->
                                </div>
                            </div>

                            <div class="alert alert-primary border-0 p-3 mt-auto mb-0" style="font-size:0.8rem;">
                                <i class="bi bi-lightbulb-fill text-warning me-1"></i> Focus on weak areas to increase your class rank percentile.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FULL RESULTS TABLE -->
                <div class="mt-4 border rounded p-0 overflow-hidden bg-white">
                    <div class="bg-light px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark"><i class="bi bi-card-checklist text-primary me-2"></i>Completed Assessments Log</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="table-light text-muted small text-uppercase" style="letter-spacing: 0.5px;">
                                    <th class="ps-4 py-3">Assessment Name</th>
                                    <th class="py-3">Performance Grade</th>
                                    <th class="py-3">Raw Score</th>
                                    <th class="py-3">Completed On</th>
                                    <th class="pe-4 py-3 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody id="performanceFullTableBody">
                                <tr><td colspan="5" class="text-center text-muted py-5">Loading assessment history...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <!-- CERTIFICATES TAB -->
        <div id="student-tab-certificates" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-patch-check-fill text-primary me-2"></i>Earned Credentials & Certificates</h4>
                <p class="text-muted small mb-4">Credentials are issued automatically for scoring 80% or higher on assessments.</p>
                <div class="row g-3" id="certificatesGrid">
                    <!-- Loaded dynamically via results compiler -->
                </div>
            </div>
        </div>

        <!-- NOTIFICATIONS TAB -->
        <div id="student-tab-notifications" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3 flex-wrap gap-2">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-bell-fill text-primary me-2"></i>Notification Center</h4>
                        <p class="text-muted small mb-0">System alerts, assessment triggers, and reviews.</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="markAllRead(this)">Mark All Read</button>
                    <script>
                        function markAllRead(btn) {
                            const originalText = btn.innerHTML;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                            btn.disabled = true;
                            fetch('/exams/api/notifications/clear', { 
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
                                }
                            })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    btn.innerHTML = originalText;
                                    btn.disabled = false;
                                }
                            })
                            .catch(err => {
                                console.error('Error marking read:', err);
                                btn.innerHTML = originalText;
                                btn.disabled = false;
                            });
                        }
                    </script>
                </div>
                <div class="d-flex flex-column gap-3" id="notificationCenterList">
                    <% if (typeof allNotifications !== 'undefined' && allNotifications.length > 0) { %>
                        <% allNotifications.forEach(notif => { 
                            let borderClass = 'border-primary';
                            let badgeClass = 'bg-primary';
                            if (notif.category === 'exam') { borderClass = 'border-success'; badgeClass = 'bg-success'; }
                            else if (notif.category === 'urgent') { borderClass = 'border-danger'; badgeClass = 'bg-danger'; }
                            else if (notif.category === 'system') { borderClass = 'border-info'; badgeClass = 'bg-info text-dark'; }
                        %>
                        <div class="p-3 <%= notif.read ? 'bg-white border' : 'bg-light border-start border-4' %> <%= notif.read ? 'border-light' : borderClass %> rounded d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge <%= badgeClass %> text-uppercase mb-1" style="font-size:0.6rem;"><%= notif.category %></span>
                                <h6 class="fw-bold text-dark mb-1"><%= notif.title %></h6>
                                <p class="text-muted mb-0 small"><%= notif.body %></p>
                            </div>
                            <span class="text-muted small text-nowrap ms-3"><%= new Date(notif.createdAt).toLocaleDateString() %> <%= new Date(notif.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center text-muted py-5 rounded bg-light border border-dashed">
                            <i class="bi bi-bell-slash fs-2 d-block mb-2 text-muted"></i>
                            No notifications available.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- CALENDAR TAB -->
        <div id="student-tab-calendar" class="student-portal-tab-content d-none">
            <div class="card p-4 border-0 shadow-sm">
                <h4 class="fw-bold mb-2 text-dark"><i class="bi bi-calendar-event text-primary me-2"></i>Interactive Assessment Calendar</h4>
                <p class="text-muted small mb-4">Track upcoming quizzes, homework, and mid-term dates.</p>
                <div class="p-4 bg-light rounded text-center border">
                    <h5 class="fw-bold text-primary mb-3">July 2026</h5>
                    
                    <!-- Calendar Grid Grid -->
                    <div class="row g-2" style="font-size:0.875rem;">
                        <% for (let d = 1; d <= 31; d++) { %>
                            <% const isExamDay = (d === 5 || d === 12 || d === 18); %>
                            <div class="col-3 col-md-2 p-2 border rounded <%= isExamDay ? 'bg-primary bg-opacity-10 border-primary text-primary fw-bold' : 'bg-white text-muted' %>">
                                <div><%= d %></div>
                                <% if (isExamDay) { %>
                                    <span class="d-none d-md-inline text-primary" style="font-size: 0.65rem;">Exam Target</span>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- PROFILE TAB -->
        <div id="student-tab-profile" class="student-portal-tab-content d-none">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card p-4 border-0 shadow-sm text-center bg-white">
                        <div class="avatar-circle mx-auto bg-primary text-white mb-3" style="width:96px; height:96px; font-size:2.5rem;">
                            <%= user.username.substring(0,2).toUpperCase() %>
                        </div>
                        <h4 class="fw-bold text-dark mb-1"><%= user.username %></h4>
                        <span class="badge bg-primary text-uppercase mb-3"><%= user.role %></span>
                        
                        <div class="p-3 bg-light rounded text-start small mb-3">
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Academic Rating:</span>
                                <span class="fw-bold text-dark" id="profileAvgLabel">90%</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Submissions:</span>
                                <span class="fw-bold text-dark" id="profileCountLabel">0</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="card p-4 border-0 shadow-sm bg-white">
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i>Academic Record Credentials</h5>
                        <hr class="mt-0">
                        <form id="profileChangeForm" onsubmit="alert('Profile details updated successfully (Mock Action).'); return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Username</label>
                                    <input type="text" class="form-control" value="<%= user.username %>" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small">Email Address</label>
                                    <input type="email" class="form-control" value="<%= user.email %>" readonly>
                                </div>
