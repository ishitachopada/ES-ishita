<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ExamSystem - Something Went Wrong</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100" style="padding-top:0;">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                <div class="card border-0 shadow-sm p-4 p-md-5 bg-white">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="stat-icon accent-danger" style="width: 56px; height: 56px; border-radius: 50%;">
                            <i class="bi bi-bug fs-3"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1 text-dark">Something went wrong</h3>
                            <p class="text-muted mb-0">The portal encountered an unexpected runtime exception.</p>
                        </div>
                    </div>
                    
                    <div class="alert alert-danger mb-4 border-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Error Message:</strong> <%= error.message || 'An unexpected error occurred.' %>
                    </div>
                    
                    <% if (error.stack) { %>
                        <h6 class="fw-bold text-dark mb-2">Technical Stack Trace:</h6>
                        <div class="bg-dark text-light p-3 rounded mb-4 overflow-auto" style="max-height: 250px; font-family: monospace; font-size: 0.8rem;">
                            <pre class="mb-0 text-white-50" style="white-space: pre-wrap; word-break: break-all;"><%= error.stack %></pre>
                        </div>
                    <% } %>
                    
                    <div class="d-flex gap-2">
                        <a href="/" class="btn btn-primary btn-sm px-4"><i class="bi bi-house-door me-1"></i> Return Home</a>
                        <a href="/login" class="btn btn-outline-secondary btn-sm px-4">Sign In again</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
