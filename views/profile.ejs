<%- include('partials/header', { title: 'My Profile', activeNav: user.role === 'student' ? 'exams' : 'admin' }) %>

<div class="row g-4">

    <!-- LEFT COLUMN: Avatar + Quick Info Card -->
    <div class="col-12 col-lg-4">

        <!-- Profile Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <!-- Gradient Banner -->
            <div style="height: 90px; background: linear-gradient(135deg, #1E3A8A 0%, #10B981 100%);"></div>

            <div class="card-body text-center pt-0 pb-4 px-4">
                <!-- Avatar with upload -->
                <div class="mx-auto position-relative" style="width: 90px; margin-top: -45px;">

                    <!-- Hidden file input -->
                    <input type="file" id="avatarFileInput" accept="image/png, image/jpeg, image/webp, image/gif"
                           style="display:none;" onchange="handleAvatarChange(this)">

                    <!-- Clickable avatar wrapper -->
                    <div id="avatarWrapper" onclick="document.getElementById('avatarFileInput').click()"
                         title="Click to change photo"
                         style="width:90px; height:90px; border-radius:50%; cursor:pointer; position:relative; overflow:hidden;"
                         class="shadow border border-4 border-white mx-auto">

                        <% if (user.profileImage) { %>
                            <!-- Show saved photo -->
                            <img id="avatarImg" src="<%= user.profileImage %>" alt="Profile Photo"
                                 style="width:100%; height:100%; object-fit:cover; display:block;">
                            <div id="avatarInitials" style="display:none;"></div>
                        <% } else { %>
                            <!-- Show initials -->
                            <div id="avatarInitials"
                                 class="bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                 style="width:100%; height:100%; font-size:2rem; font-family:'Outfit',sans-serif;">
                                <%= user.username.substring(0,2).toUpperCase() %>
                            </div>
                            <img id="avatarImg" src="" alt="" style="width:100%; height:100%; object-fit:cover; display:none; position:absolute; top:0; left:0;">
                        <% } %>

                        <!-- Hover overlay with camera icon -->
                        <div id="avatarOverlay"
                             style="position:absolute; inset:0; background:rgba(0,0,0,0.45); border-radius:50%;
                                    display:flex; align-items:center; justify-content:center;
                                    opacity:0; transition:opacity 0.2s ease; pointer-events:none;">
                            <i class="bi bi-camera-fill text-white" style="font-size:1.4rem;"></i>
                        </div>
                    </div>

                    <!-- Role badge -->
                    <% if (user.role === 'admin') { %>
                    <span class="position-absolute bottom-0 end-0 badge bg-danger rounded-pill border border-2 border-white" style="font-size:0.6rem; padding: 4px 7px;">
                        ADMIN
                    </span>
                    <% } else if (user.role === 'faculty') { %>
                    <span class="position-absolute bottom-0 end-0 badge bg-warning text-dark rounded-pill border border-2 border-white" style="font-size:0.6rem; padding: 4px 7px;">
                        FACULTY
                    </span>
                    <% } else { %>
                    <span class="position-absolute bottom-0 end-0 badge bg-success rounded-pill border border-2 border-white" style="font-size:0.6rem; padding: 4px 7px;">
                        STUDENT
                    </span>
                    <% } %>
                </div>

                <!-- Upload action buttons (shown after picking a file) -->
                <div id="avatarActions" class="mt-3 d-none d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold" onclick="uploadAvatar()">
                        <i class="bi bi-cloud-upload me-1"></i> Save Photo
                    </button>
                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3 fw-semibold" onclick="cancelAvatarChange()">
                        Cancel
                    </button>
                </div>
                <!-- Remove photo button (only if photo exists) -->
                <% if (user.profileImage) { %>
                <div class="mt-2">
                    <form action="/profile/remove-photo" method="POST" style="display:inline;" id="removePhotoForm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="button" class="btn btn-link btn-sm text-danger p-0" style="font-size:0.78rem;"
                                data-bs-toggle="modal" data-bs-target="#removePhotoModal">
                            <i class="bi bi-trash me-1"></i>Remove photo
                        </button>
                    </form>
                </div>
                <% } %>

                <h4 class="fw-bold mt-3 mb-0 text-dark" style="font-family:'Poppins',sans-serif;"><%= user.displayName || user.username %></h4>
                <p class="text-muted small mb-1">@<%= user.username %></p>
                <p class="text-muted small mb-3"><i class="bi bi-envelope me-1"></i><%= user.email %></p>

                <% if (user.department) { %>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-3">
                    <i class="bi bi-building me-1"></i><%= user.department %>
                </span>
                <% } %>

                <div class="d-flex justify-content-around border-top pt-3 mt-2">
                    <div class="text-center">
                        <div class="fw-bold text-dark fs-5"><%= stats.totalExams %></div>
                        <div class="text-muted" style="font-size:0.75rem;">Exams<% if(user.role !== 'student') { %> Created<% } else { %> Taken<% } %></div>
                    </div>
                    <div class="text-center border-start border-end px-3">
                        <div class="fw-bold text-dark fs-5"><%= stats.passed %></div>
                        <div class="text-muted" style="font-size:0.75rem;"><% if(user.role !== 'student') { %>Active<% } else { %>Passed<% } %></div>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold text-dark fs-5"><%= stats.avgScore %>%</div>
                        <div class="text-muted" style="font-size:0.75rem;"><% if(user.role !== 'student') { %>Reports<% } else { %>Avg Score<% } %></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Info Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Account Details</h6>
                <ul class="list-unstyled mb-0" style="font-size:0.875rem;">
                    <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">Role</span>
                        <span class="fw-semibold text-dark text-capitalize"><%= user.role %></span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">Auth Provider</span>
                        <span class="fw-semibold text-dark text-capitalize">
                            <% if(user.authProvider === 'google') { %>
                                <i class="bi bi-google text-danger me-1"></i>Google
                            <% } else { %>
                                <i class="bi bi-lock text-primary me-1"></i>Local
                            <% } %>
                        </span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted">Verified</span>
                        <span>
                            <% if(user.isVerified) { %>
                                <span class="badge bg-success-subtle text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>Yes</span>
                            <% } else { %>
                                <span class="badge bg-danger-subtle text-danger fw-semibold"><i class="bi bi-x-circle me-1"></i>No</span>
                            <% } %>
                        </span>
                    </li>
                    <li class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Member Since</span>
                        <span class="fw-semibold text-dark"><%= new Date(user.createdAt).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></span>
                    </li>
                </ul>
            </div>
        </div>

    </div>

    <!-- RIGHT COLUMN: Edit Forms -->
    <div class="col-12 col-lg-8">

        <!-- Edit Profile Form -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-person-gear text-primary me-2"></i>Edit Profile</h5>
                <p class="text-muted small mb-4">Update your display name and department information.</p>

                <form action="/profile/update" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-at"></i></span>
                                <input type="text" class="form-control border-start-0 bg-light text-muted" value="<%= user.username %>" disabled>
                            </div>
                            <div class="form-text">Username cannot be changed.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Display Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input type="text" name="displayName" class="form-control border-start-0"
                                       value="<%= user.displayName || '' %>" placeholder="Your full name" maxlength="60">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 bg-light text-muted" value="<%= user.email %>" disabled>
                            </div>
                            <div class="form-text">Email cannot be changed.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Department</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-building"></i></span>
                                <input type="text" name="department" class="form-control border-start-0"
                                       value="<%= user.department || '' %>" placeholder="e.g. Computer Science" maxlength="100">
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold rounded-pill">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                        <a href="<%= user.role === 'student' ? '/exams' : '/admin/dashboard' %>" class="btn btn-light px-4 rounded-pill fw-semibold">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Change Password Form (only for local auth) -->
        <% if (!user.authProvider || user.authProvider === 'local') { %>
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock text-warning me-2"></i>Change Password</h5>
                <p class="text-muted small mb-4">Use a strong password with letters, numbers, and symbols.</p>

                <form action="/profile/change-password" method="POST" id="passwordForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                <input type="password" name="newPassword" class="form-control border-start-0"
                                       placeholder="New password" required minlength="6" id="newPasswordInput">
                                <button class="btn btn-light border border-start-0" type="button" onclick="togglePassword('newPasswordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Confirm New Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key-fill"></i></span>
                                <input type="password" name="confirmPassword" class="form-control border-start-0"
                                       placeholder="Confirm new password" required minlength="6" id="confirmPasswordInput">
                                <button class="btn btn-light border border-start-0" type="button" onclick="togglePassword('confirmPasswordInput', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Password strength meter -->
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="progress flex-grow-1" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrengthBar" role="progressbar" style="width: 0%; transition: all 0.3s;"></div>
                                </div>
                                <small id="passwordStrengthText" class="text-muted fw-semibold" style="min-width: 60px; font-size:0.72rem;"></small>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning px-4 fw-semibold rounded-pill text-dark">
                            <i class="bi bi-shield-check me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>

        <!-- Recent Activity (for students: last exams; for admin/faculty: recent actions) -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Recent Activity</h5>
                <p class="text-muted small mb-4">Your last <%= recentActivity.length %> recorded actions.</p>

                <% if (recentActivity && recentActivity.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold">Exam</th>
                                <th class="fw-semibold">Status</th>
                                <th class="fw-semibold">Score</th>
                                <th class="fw-semibold">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentActivity.forEach(sub => { %>
                            <tr>
                                <td class="fw-semibold text-dark"><%= sub.exam ? sub.exam.title : 'N/A' %></td>
                                <td>
                                    <% if (sub.status === 'submitted') { %>
                                        <span class="badge bg-success-subtle text-success">Submitted</span>
                                    <% } else if (sub.status === 'invalidated') { %>
                                        <span class="badge bg-danger-subtle text-danger">Invalidated</span>
                                    <% } else { %>
                                        <span class="badge bg-warning-subtle text-warning">In Progress</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (sub.status === 'submitted') { %>
                                        <span class="fw-semibold text-primary"><%= sub.score %>/<%= sub.totalQuestions %></span>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                                <td class="text-muted">
                                    <%= new Date(sub.submittedAt).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x fs-2 d-block mb-2 opacity-50"></i>
                    No activity recorded yet.
                </div>
                <% } %>
            </div>
        </div>

    </div>
</div>

<script>
// ── Avatar hover overlay ──────────────────────────────────────────────
(function () {
    const wrapper = document.getElementById('avatarWrapper');
    const overlay = document.getElementById('avatarOverlay');
    if (!wrapper || !overlay) return;
    wrapper.addEventListener('mouseenter', () => overlay.style.opacity = '1');
    wrapper.addEventListener('mouseleave', () => overlay.style.opacity = '0');
})();

let selectedAvatarFile = null;
const originalAvatarSrc = (function () {
    const img = document.getElementById('avatarImg');
    return img ? img.src : '';
})();

function handleAvatarChange(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    // Size guard: 2 MB max
    if (file.size > 2 * 1024 * 1024) {
        alert('Image must be smaller than 2 MB.');
        input.value = '';
        return;
    }

    selectedAvatarFile = file;
    const reader = new FileReader();
    reader.onload = function (e) {
        const img = document.getElementById('avatarImg');
        const initials = document.getElementById('avatarInitials');
        img.src = e.target.result;
        img.style.display = 'block';
        if (initials) initials.style.display = 'none';
    };
    reader.readAsDataURL(file);

    // Show save/cancel buttons
    const actions = document.getElementById('avatarActions');
    if (actions) actions.classList.remove('d-none');
}

function cancelAvatarChange() {
    selectedAvatarFile = null;
    const input = document.getElementById('avatarFileInput');
    if (input) input.value = '';

    const img = document.getElementById('avatarImg');
    const initials = document.getElementById('avatarInitials');
    if (originalAvatarSrc && originalAvatarSrc !== window.location.href) {
        img.src = originalAvatarSrc;
        img.style.display = 'block';
        if (initials) initials.style.display = 'none';
    } else {
        img.style.display = 'none';
        if (initials) initials.style.display = 'flex';
    }

    const actions = document.getElementById('avatarActions');
    if (actions) actions.classList.add('d-none');
}

function uploadAvatar() {
    if (!selectedAvatarFile) return;

    const formData = new FormData();
    formData.append('avatar', selectedAvatarFile);

    // Read CSRF token from meta tag (set in header.ejs)
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

    const saveBtn = document.querySelector('#avatarActions .btn-primary');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...'; }

    fetch('/profile/upload-photo', {
        method: 'POST',
        body: formData,
        headers: {
            'x-csrf-token': csrfToken
        }
    })
    .then(r => r.json())
    .then(data => {
        if (data.ok) {
            // Reload page to reflect new photo in header avatar too
            window.location.reload();
        } else {
            alert(data.error || 'Upload failed. Please try again.');
            if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i> Save Photo'; }
        }
    })
    .catch(() => {
        alert('Network error. Please try again.');
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i> Save Photo'; }
    });
}

// Confirm remove photo via custom modal
document.addEventListener('DOMContentLoaded', function () {
    const confirmBtn = document.getElementById('confirmRemovePhotoBtn');
    if (confirmBtn) {
        confirmBtn.addEventListener('click', function () {
            document.getElementById('removePhotoForm').submit();
        });
    }
});

// ── Password toggle ───────────────────────────────────────────────────
function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

// Password strength meter
const newPwdInput = document.getElementById('newPasswordInput');
const strengthBar = document.getElementById('passwordStrengthBar');
const strengthText = document.getElementById('passwordStrengthText');

if (newPwdInput && strengthBar) {
    newPwdInput.addEventListener('input', function () {
        const val = this.value;
        let score = 0;
        if (val.length >= 6) score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { pct: 0,   color: '',          label: '' },
            { pct: 20,  color: 'bg-danger',  label: 'Very Weak' },
            { pct: 40,  color: 'bg-warning', label: 'Weak' },
            { pct: 60,  color: 'bg-info',    label: 'Fair' },
            { pct: 80,  color: 'bg-primary', label: 'Strong' },
            { pct: 100, color: 'bg-success', label: 'Very Strong' },
        ];

        const level = levels[score] || levels[0];
        strengthBar.style.width = level.pct + '%';
        strengthBar.className = 'progress-bar ' + level.color;
        if (strengthText) strengthText.textContent = level.label;
    });
}

// Confirm password match check
const confirmInput = document.getElementById('confirmPasswordInput');
const passwordForm = document.getElementById('passwordForm');
if (passwordForm && confirmInput) {
    passwordForm.addEventListener('submit', function (e) {
        const newPwd = document.getElementById('newPasswordInput').value;
        if (newPwd !== confirmInput.value) {
            e.preventDefault();
            confirmInput.classList.add('is-invalid');
            // show inline error
            let err = confirmInput.parentElement.nextElementSibling;
            if (!err || !err.classList.contains('invalid-feedback')) {
                err = document.createElement('div');
                err.className = 'invalid-feedback d-block';
                confirmInput.parentElement.after(err);
            }
            err.textContent = 'Passwords do not match.';
        }
    });
    confirmInput.addEventListener('input', function () {
        this.classList.remove('is-invalid');
        const err = this.parentElement.nextElementSibling;
        if (err && err.classList.contains('invalid-feedback')) err.textContent = '';
    });
}
</script>

<!-- ── Remove Photo Confirmation Modal ───────────────────────────── -->
<div class="modal fade" id="removePhotoModal" tabindex="-1" aria-labelledby="removePhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Coloured top strip -->
            <div style="height: 5px; background: linear-gradient(90deg, #EF4444, #F97316);"></div>

            <div class="modal-body p-4 text-center">
                <!-- Icon -->
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger-subtle"
                     style="width:64px; height:64px;">
                    <i class="bi bi-person-x-fill text-danger" style="font-size:1.8rem;"></i>
                </div>

                <h5 class="fw-bold text-dark mb-1" id="removePhotoModalLabel">Remove Profile Photo?</h5>
                <p class="text-muted mb-0" style="font-size:0.9rem;">
                    Your profile photo will be deleted permanently.<br>
                    Your <strong>initials</strong> will be shown instead.
                </p>
            </div>

            <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold"
                        id="confirmRemovePhotoBtn">
                    <i class="bi bi-trash me-1"></i> Yes, Remove
                </button>
            </div>

        </div>
    </div>
</div>

<%- include('partials/footer') %>
